def validate_json_value(value, schema, path="arguments", depth=0):
    """Validate model arguments against the manifest's JSON Schema subset.

    Returns an error string or None. Unknown keywords are ignored; supported:
    type, enum, properties/required/additionalProperties, items, min/max
    Items, min/max Length, minimum/maximum, plus the "nullable" spelling.
    """
    if depth > 16:
        return "%s: schema too deep" % path
    if not isinstance(schema, dict):
        return None
    types = {"object": dict, "array": list, "string": str, "boolean": bool,
             "number": (int, float), "integer": int, "null": type(None)}
    declared = schema.get("type")
    if isinstance(declared, str):
        if declared not in types:
            return "%s: unsupported schema type" % path
        ok = isinstance(value, types[declared]) and not (
            declared in ("number", "integer") and isinstance(value, bool))
        if not ok:
            return "%s: expected %s" % (path, declared)
    elif isinstance(declared, list):
        if not any(validate_json_value(value, dict(schema, type=t), path, depth + 1) is None
                   for t in declared):
            return "%s: wrong type" % path
    enum = schema.get("enum")
    if isinstance(enum, list) and value not in enum:
        return "%s: must be one of %s" % (path, ", ".join(map(str, enum))[:200])
    if isinstance(value, dict):
        properties = schema.get("properties", {})
        if not isinstance(properties, dict):
            return "%s: invalid schema" % path
        required = schema.get("required", [])
        if not isinstance(required, list) or not all(isinstance(r, str) for r in required):
            return "%s: invalid schema" % path
        for name in required:
            if name not in value:
                return "%s.%s: required" % (path, name)
        extra = schema.get("additionalProperties", True)
        for key, item in value.items():
            if not isinstance(key, str):
                return "%s: invalid argument name" % path
            if key in properties:
                error = validate_json_value(item, properties[key],
                                            "%s.%s" % (path, key), depth + 1)
                if error:
                    return error
            elif extra is False:
                return "%s.%s: unexpected argument" % (path, key)
    elif isinstance(value, list):
        items = schema.get("items")
        if isinstance(items, dict):
            for index, item in enumerate(value):
                error = validate_json_value(item, items, "%s[%d]" % (path, index), depth + 1)
                if error:
                    return error
        for key, test in (("minItems", lambda n: len(value) < n),
                          ("maxItems", lambda n: len(value) > n)):
            bound = schema.get(key)
            if isinstance(bound, int) and not isinstance(bound, bool) and test(bound):
                return "%s: %s %d" % (path, key, bound)
    elif isinstance(value, str):
        for key, test in (("minLength", lambda n: len(value) < n),
                          ("maxLength", lambda n: len(value) > n)):
            bound = schema.get(key)
            if isinstance(bound, int) and not isinstance(bound, bool) and test(bound):
                return "%s: %s %d" % (path, key, bound)
    elif isinstance(value, (int, float)) and not isinstance(value, bool):
        low, high = schema.get("minimum"), schema.get("maximum")
        if isinstance(low, (int, float)) and value < low:
            return "%s: below minimum %s" % (path, low)
        if isinstance(high, (int, float)) and value > high:
            return "%s: above maximum %s" % (path, high)
    return None


class CustomTool:
    """User-defined tool: a JSON manifest plus an argv command (no shell).

    Manifest keys: name, description, command (argv list), parameters
    (JSON Schema subset), optional timeout (seconds), output_limit, confirm.
    Arguments arrive as JSON on stdin; stdout must be JSON (or text).
    "{manifest_dir}" in an argv part expands to the manifest's directory.
    """

    def __init__(self, manifest):
        self.path = Path(manifest)
        try:
            obj = json.loads(self.path.read_text(encoding="utf-8"))
        except (OSError, ValueError, UnicodeDecodeError) as e:
            raise AIError("cannot read manifest: %s" % e) from e
        if not isinstance(obj, dict):
            raise AIError("manifest must be a JSON object")
        name = obj.get("name")
        if not isinstance(name, str) or not CUSTOM_TOOL_NAME.match(name):
            raise AIError("name must match ^[a-z][a-z0-9_]{1,40}$")
        description = obj.get("description")
        if not isinstance(description, str) or not 0 < len(description) <= 1024:
            raise AIError("description must be 1..1024 characters")
        command = obj.get("command")
        if (not isinstance(command, list) or not 1 <= len(command) <= 16
                or not all(isinstance(part, str) and part for part in command)):
            raise AIError("command must be a non-empty argv list of strings")
        parameters = obj.get("parameters", {"type": "object", "properties": {}})
        if not isinstance(parameters, dict) or parameters.get("type") != "object":
            raise AIError("parameters must be a JSON Schema object")
        if not isinstance(parameters.get("properties", {}), dict):
            raise AIError("parameters.properties must be an object")
        timeout = obj.get("timeout", 30)
        if (not isinstance(timeout, (int, float)) or isinstance(timeout, bool)
                or not 0 < timeout <= CUSTOM_TOOL_TIMEOUT):
            raise AIError("timeout must be 0..%d seconds" % CUSTOM_TOOL_TIMEOUT)
        output_limit = obj.get("output_limit", 65536)
        if (not isinstance(output_limit, int) or isinstance(output_limit, bool)
                or not 256 <= output_limit <= 262144):
            raise AIError("output_limit must be 256..262144 bytes")
        confirm = obj.get("confirm", False)
        if not isinstance(confirm, bool):
            raise AIError("confirm must be true or false")
        self.name, self.description = name, description
        # {manifest_dir} keeps manifests portable (cwd is the tool root, so
        # relative script paths would otherwise resolve against the project).
        here = str(self.path.resolve().parent)
        self.command = [part.replace("{manifest_dir}", here) for part in command]
        self.parameters = parameters
        self.timeout, self.output_limit, self.confirm = float(timeout), output_limit, confirm

    def schema(self):
        return {"type": "function", "function": {
            "name": self.name, "description": self.description,
            "parameters": self.parameters}}

    def validate(self, args):
        if not isinstance(args, dict):
            return "arguments must be a JSON object"
        return validate_json_value(args, self.parameters)

    def run(self, args, root, out=None):
        data = json.dumps(args, ensure_ascii=False).encode("utf-8")
        if len(data) > 65536:
            return json.dumps({"error": "arguments too large"})
        env = {k: v for k, v in os.environ.items()
               if k not in KEY_ENVS and not any(word in k.upper()
                   for word in ("API_KEY", "TOKEN", "SECRET", "PASSWORD", "CREDENTIAL"))}
        env.update({"DANI_TOOL_NAME": self.name, "DANI_TOOL_ROOT": str(root)})
        output, errors, stopped, code = _run_tool_process(
            self.command, root, env, data, self.timeout, self.output_limit)
        text = output.decode("utf-8", "replace")
        error_text = errors.decode("utf-8", "replace")[:2048]
        if stopped:
            return json.dumps({"error": "tool stopped: %s" % stopped,
                               "stderr": error_text, "untrusted": True}, ensure_ascii=False)
        if code != 0:
            return json.dumps({"error": "tool exited with %s" % code,
                               "stdout": text[:16000], "stderr": error_text,
                               "untrusted": True}, ensure_ascii=False)
        if not text.strip():
            return json.dumps({"error": "tool produced no output", "stderr": error_text,
                               "untrusted": True}, ensure_ascii=False)
        # Process output is already bounded by the manifest's byte limit.
        # Never slice serialized JSON: that silently destroys its structure.
        try:
            parsed = json.loads(text)
        except ValueError:
            parsed = text
        result = {"result": parsed, "untrusted": True}
        if error_text:
            result["stderr"] = error_text[:512]
        return json.dumps(result, ensure_ascii=False)


def _run_tool_process(argv, cwd, env, stdin_data, timeout, output_limit):
    """Run a custom tool with a temp-file stdin and bounded pipes."""
    output, errors = bytearray(), bytearray()
    stopped, code = None, None
    with tempfile.TemporaryFile() as stdin_file:
        stdin_file.write(stdin_data)
        stdin_file.seek(0)
        try:
            process = subprocess.Popen(argv, cwd=cwd, stdin=stdin_file,
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       env=env, start_new_session=True, close_fds=True)
        except OSError as e:
            return output, str(e).encode(), "spawn", None
        deadline = time.monotonic() + timeout
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                selector.register(process.stderr, selectors.EVENT_READ)
                while selector.get_map() and not stopped:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        stopped = "timeout"
                        break
                    for key, _ in selector.select(min(remaining, 0.1)):
                        target = output if key.fileobj is process.stdout else errors
                        limit = output_limit if target is output else 4096
                        room = max(1, limit + 1 - len(target))
                        chunk = os.read(key.fileobj.fileno(), min(8192, room))
                        if not chunk:
                            selector.unregister(key.fileobj)
                            continue
                        target.extend(chunk)
                        if len(target) > limit:
                            stopped = "output_limit"
                            break
                if not stopped:
                    try:
                        process.wait(timeout=max(0.001, deadline - time.monotonic()))
                    except subprocess.TimeoutExpired:
                        stopped = "timeout"
        finally:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            process.wait()
            process.stdout.close()
            process.stderr.close()
        code = process.returncode
    return output[:output_limit], errors[:4096], stopped, code


def validate_assistant(message):
    if not isinstance(message, dict) or message.get("content") is not None and not isinstance(message.get("content"), str):
        raise AIError("invalid assistant message")
    calls = message.get("tool_calls", [])
    if not isinstance(calls, list) or len(calls) > 16:
        raise AIError("invalid tool calls")
    ids = set()
    for call in calls:
        if not isinstance(call, dict) or call.get("type") != "function":
            raise AIError("invalid tool call")
        function = call.get("function")
        cid = call.get("id")
        if not isinstance(cid, str) or not cid or cid in ids or not isinstance(function, dict):
            raise AIError("invalid tool call id/function")
        ids.add(cid)
        if not isinstance(function.get("name"), str) or not isinstance(function.get("arguments"), str):
            raise AIError("invalid tool function")
        if len(function["arguments"]) > 65536:
            raise AIError("tool arguments too large")
    if not calls and not isinstance(message.get("content"), str):
        raise AIError("missing assistant content")
    result = {"role": "assistant", "content": message.get("content")}
    if calls:
        result["tool_calls"] = calls
    return result


class ToolRunner:
    """File tools, bounded shell execution, and user-defined tools.

    Builtin shell execution is NOT sandboxed; custom tools run as argv (no
    shell) inside the tool root and are gated by an optional confirm prompt.
    """
    def __init__(self, root, blocked=(), blocklist=None, custom_dir=None,
                 confirm=None, allow_shell=False):
        """custom_dir: manifest dir; falsy (None/"") loads no custom tools."""
        self.root = Path(root).resolve(strict=True)
        if not self.root.is_dir():
            raise AIError("tool root must be a directory")
        default = Path(default_system_file()).with_name("ai.tools.blocklist")
        path = Path(blocklist) if blocklist else default
        self.allow_shell = allow_shell
        self.blocked = list(blocked)
        if blocklist or path.exists():
            self.blocked += [line.split("#", 1)[0].strip()
                             for line in path.read_text(encoding="utf-8").splitlines()
                             if line.split("#", 1)[0].strip()]
        # confirm(name, description) -> True to run; None disables prompting.
        self.confirm = confirm
        self.custom = {}
        self.custom_errors = []
        self.custom_dir = None
        if custom_dir:
            directory = Path(custom_dir)
            if directory.is_dir():
                self.custom_dir = directory
                self.load_custom_tools(directory)
        self.schemas = []
        for name in TOOL_NAMES:
            if self.is_blocked(name):
                continue
            properties = {"path": {"type": "string", "description": "Relative path within tool root"}}
            required = ["path"]
            if name == "search_text":
                properties["query"] = {"type": "string", "description": "Literal text to find in this file"}
                required.append("query")
            if name == "git_status":
                properties = {}
                required = []
            if name == "write_file":
                properties["content"] = {"type": "string", "description": "Complete UTF-8 content for a NEW file (max 64 KiB). Parent directory must exist."}
                required.append("content")
            if name == "edit_file":
                properties["old_text"] = {"type": "string", "description": "Nonempty exact text that occurs exactly once in the existing file. Read the file first."}
                properties["new_text"] = {"type": "string", "description": "Replacement text; may be empty to delete the matched text."}
                required += ["old_text", "new_text"]
            if name == "run_command":
                properties = {"command": {"type": "string", "description": "Linux shell command, executed using /bin/sh"}}
                required = ["command"]
            self.schemas.append({"type": "function", "function": {
                "name": name, "description": {
                    "list_files": "List a directory (nonrecursive, maximum 200 entries).",
                    "git_status": "Read Git status and branch for the repository containing tool root. No arguments, no shell, no commits or file changes. Returns tool root so the user can verify the selected project.",
                    "read_file": "Read a UTF-8 text file (maximum 64 KiB).",
                    "write_file": "Create a NEW UTF-8 file inside tool root without confirmation. Never overwrites existing files. Parent must exist. Max 64 KiB.",
                    "edit_file": "Edit an existing UTF-8 file inside tool root without confirmation using one unique exact-text replacement. Read first. Max 64 KiB. No symlinks or sensitive paths.",
                    "search_text": "Find literal text in one UTF-8 file (maximum 100 matching lines).",
                    "run_command": "Run a Linux shell command in tool root with user privileges. NOT sandboxed: can write files, access network and paths outside root. 30s timeout, 64 KiB combined output limit. Avoid destructive commands unless explicitly requested."
                }[name], "parameters": {"type": "object", "properties": properties,
                                        "required": required, "additionalProperties": False}}})
        for tool in self.custom.values():
            self.schemas.append(tool.schema())

    def load_custom_tools(self, directory):
        """Load <name>.json manifests; invalid or shadowing manifests are skipped."""
        seen = set(TOOL_NAMES)
        for manifest in sorted(directory.glob("*.json")):
            try:
                tool = CustomTool(manifest)
            except AIError as e:
                self.custom_errors.append("%s: %s" % (manifest.name, e))
                continue
            if tool.name in seen:
                self.custom_errors.append("%s: name %s already defined"
                                          % (manifest.name, tool.name))
                continue
            if len(self.custom) >= CUSTOM_TOOL_MAX:
                self.custom_errors.append("%s: too many custom tools (max %d)"
                                          % (manifest.name, CUSTOM_TOOL_MAX))
                break
            if self.is_blocked(tool.name):
                continue
            seen.add(tool.name)
            self.custom[tool.name] = tool

    def is_blocked(self, name):
        return (name == "run_command" and not self.allow_shell) or any(
            fnmatch.fnmatchcase(name, pattern) for pattern in self.blocked)

    def set_shell(self, enabled):
        self.allow_shell = enabled
        self.schemas = [s for s in self.schemas if s["function"]["name"] != "run_command"]
        if not self.is_blocked("run_command"):
            self.schemas.append({"type": "function", "function": {
                "name": "run_command",
                "description": "Run /bin/sh in tool root with user privileges. NOT sandboxed; can write files, use network and access outside root. 30s timeout, 64 KiB output limit.",
                "parameters": {"type": "object", "properties": {
                    "command": {"type": "string"}}, "required": ["command"],
                    "additionalProperties": False}}})

    @staticmethod
    def allowed(name):
        lower = name.lower()
        return not (name.startswith(".") or lower in {"ai.key", "ai.system", "id_rsa", "id_ed25519"}
                    or any(word in lower for word in ("secret", "credential", "password", "token"))
                    or lower.endswith((".key", ".pem", ".p12", ".pfx")))

    def open_path(self, path):
        if not isinstance(path, str) or len(path) > 4096:
            raise ValueError("invalid path")
        parts = Path(path).parts
        if Path(path).is_absolute() or any(p == ".." or not self.allowed(p) for p in parts):
            raise ValueError("path is outside root or sensitive")
        fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for i, part in enumerate(parts):
                flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK
                if i < len(parts) - 1:
                    flags |= os.O_DIRECTORY
                new = os.open(part, flags, dir_fd=fd)
                os.close(fd)
                fd = new
            return fd
        except BaseException:
            os.close(fd)
            raise

    def change_file(self, name, args):
        path = args["path"]
        if not isinstance(path, str) or not path or len(path) > 4096 or "\x00" in path:
            raise ValueError("invalid path")
        parts = Path(path).parts
        if (not parts or Path(path).is_absolute() or
                any(p == ".." or not self.allowed(p) for p in parts)):
            raise ValueError("path is outside root or sensitive")
        # Walk directories by descriptor, never following a symlink. Keep the
        # parent open for all reads, publication and cleanup (no path re-open).
        parent = self.open_path(str(Path(*parts[:-1])))
        temporary = None
        try:
            if not stat.S_ISDIR(os.fstat(parent).st_mode):
                raise ValueError("parent must be a directory")
            leaf = parts[-1]
            before = None
            mode = 0o600
            if name == "edit_file":
                old, new = args["old_text"], args["new_text"]
                if not isinstance(old, str) or not old or not isinstance(new, str):
                    raise ValueError("old_text must be nonempty and new_text must be text")
                fd = os.open(leaf, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=parent)
                try:
                    before = os.fstat(fd)
                    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
                        raise ValueError("only regular, non-hardlinked files are allowed")
                    data = os.read(fd, 65537)
                    if len(data) > 65536 or b"\x00" in data:
                        raise ValueError("file too large or binary")
                    text = data.decode("utf-8")
                finally:
                    os.close(fd)
                if text.count(old) != 1:
                    raise ValueError("old_text must match exactly once; read the file and retry")
                content = text.replace(old, new, 1)
                mode = stat.S_IMODE(before.st_mode) & 0o777
            else:
                content = args["content"]
            if not isinstance(content, str) or "\x00" in content:
                raise ValueError("content must be UTF-8 text without NUL")
            data = content.encode("utf-8")
            if len(data) > 65536:
                raise ValueError("result exceeds 64 KiB")
            temporary = ".dani-ai-write-" + os.urandom(16).hex()
            fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         0o600, dir_fd=parent)
            with os.fdopen(fd, "wb") as f:
                f.write(data)
                f.flush()
                os.fchmod(f.fileno(), mode)
                os.fsync(f.fileno())
            if before is None:
                # Atomic create-only publication: even a dangling symlink or
                # a file created concurrently must cause EEXIST, not overwrite.
                os.link(temporary, leaf, src_dir_fd=parent, dst_dir_fd=parent,
                        follow_symlinks=False)
            else:
                current = os.stat(leaf, dir_fd=parent, follow_symlinks=False)
                if (current.st_dev, current.st_ino, current.st_mtime_ns, current.st_ctime_ns,
                    current.st_size, current.st_nlink) != (
                        before.st_dev, before.st_ino, before.st_mtime_ns, before.st_ctime_ns,
                        before.st_size, before.st_nlink):
                    raise ValueError("file changed during edit; read again and retry")
                os.replace(temporary, leaf, src_dir_fd=parent, dst_dir_fd=parent)
                temporary = None
            os.fsync(parent)
            return json.dumps({"result": {"path": path, "bytes": len(data),
                                          "action": "created" if before is None else "edited"},
                               "untrusted": True}, ensure_ascii=False)
        finally:
            try:
                if temporary is not None:
                    os.unlink(temporary, dir_fd=parent)
            finally:
                os.close(parent)

    def git_status(self):
        # Do not inherit GIT_DIR/GIT_WORK_TREE/config injection from the caller.
        # Disable optional index writes, fsmonitor hooks and background maintenance.
        env = {k: v for k, v in os.environ.items()
               if not k.startswith("GIT_") and k not in KEY_ENVS and not any(
                   word in k.upper() for word in
                   ("API_KEY", "TOKEN", "SECRET", "PASSWORD", "CREDENTIAL"))}
        env.update({"GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0",
                    "GIT_CONFIG_NOSYSTEM": "1", "GIT_CONFIG_GLOBAL": os.devnull,
                    "LC_ALL": "C"})
        output, errors, stopped, code = _run_tool_process(
            ["git", "--no-pager", "--no-optional-locks", "-c", "core.fsmonitor=false",
             "-c", "maintenance.auto=false", "status", "--porcelain=v1", "--branch",
             "--untracked-files=normal", "--ignore-submodules=all"],
            self.root, env, b"", 10, 65536)
        result = {"tool_root": str(self.root), "untrusted": True}
        if stopped or code != 0:
            result["error"] = "git status failed: %s" % (stopped or "exit %s" % code)
            result["stderr"] = errors.decode("utf-8", "replace")
        else:
            result["output"] = output.decode("utf-8", "replace")
            result["format"] = "git status --porcelain=v1 --branch (submodules ignored)"
        return json.dumps(result, ensure_ascii=False)

    def run_command(self, command, timeout=30, output_limit=65536):
        if not isinstance(command, str) or not 0 < len(command) <= 16000 or "\x00" in command:
            raise ValueError("command must be 1..16000 characters without NUL")
        # Do not hand API credentials inherited from the CLI to child processes.
        # This is defense in depth, not isolation: the shell still has user rights.
        env = {k: v for k, v in os.environ.items()
               if k not in KEY_ENVS and not any(word in k.upper()
                   for word in ("API_KEY", "TOKEN", "SECRET", "PASSWORD", "CREDENTIAL"))}
        process = subprocess.Popen(["/bin/sh", "-c", command], cwd=self.root,
                                   stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.STDOUT, env=env, start_new_session=True)
        output = bytearray()
        reason = None
        deadline = time.monotonic() + timeout
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while selector.get_map():
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        reason = "timeout"
                        break
                    for key, _ in selector.select(min(remaining, 0.1)):
                        chunk = os.read(key.fileobj.fileno(), min(8192, output_limit + 1 - len(output)))
                        if not chunk:
                            selector.unregister(key.fileobj)
                            continue
                        output.extend(chunk)
                        if len(output) > output_limit:
                            reason = "output_limit"
                            break
                    if reason:
                        break
                if not reason:
                    try:
                        process.wait(timeout=max(0.001, deadline - time.monotonic()))
                    except subprocess.TimeoutExpired:
                        reason = "timeout"
        finally:
            # Also clean up background children that retained pipes or outlived sh.
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()
            process.stdout.close()
        return json.dumps({"output": bytes(output[:output_limit]).decode("utf-8", "replace"),
                           "exit_code": process.returncode, "stopped": reason,
                           "untrusted": True}, ensure_ascii=False)

    def execute_custom(self, name, arguments):
        tool = self.custom[name]
        try:
            args = json.loads(arguments)
        except (ValueError, TypeError) as e:
            return json.dumps({"error": "invalid JSON arguments: %s" % e})
        error = tool.validate(args)
        if error:
            return json.dumps({"error": "invalid arguments: %s" % error})
        if tool.confirm and self.confirm is not None:
            if not self.confirm(tool.name, tool.description):
                return json.dumps({"error": "tool call declined by user",
                                   "untrusted": True})
        return tool.run(args, self.root)

    def execute(self, name, arguments):
        try:
            if name in self.custom and not self.is_blocked(name):
                return self.execute_custom(name, arguments)
            if name not in TOOL_NAMES or self.is_blocked(name):
                raise ValueError("tool unknown or blocked")
            args = json.loads(arguments)
            required = (set() if name == "git_status" else
                        {"command"} if name == "run_command" else
                        {"path", "content"} if name == "write_file" else
                        {"path", "old_text", "new_text"} if name == "edit_file" else
                        {"path", "query"} if name == "search_text" else {"path"})
            if not isinstance(args, dict) or set(args) != required:
                raise ValueError("invalid tool arguments")
            if name == "git_status":
                return self.git_status()
            if name in ("write_file", "edit_file"):
                return self.change_file(name, args)
            if name == "run_command":
                return self.run_command(args["command"])
            if name == "search_text" and (not isinstance(args["query"], str) or not 0 < len(args["query"]) <= 1000):
                raise ValueError("query must be 1..1000 characters")
            fd = self.open_path(args["path"])
            try:
                info = os.fstat(fd)
                if name == "list_files":
                    if not stat.S_ISDIR(info.st_mode):
                        raise ValueError("not a directory")
                    entries = []
                    with os.scandir(fd) as it:
                        for scanned, entry in enumerate(it):
                            if scanned >= 2000 or len(entries) >= 200:
                                entries.append("[truncated]")
                                break
                            if self.allowed(entry.name) and not entry.is_symlink():
                                entries.append(entry.name + ("/" if entry.is_dir(follow_symlinks=False) else ""))
                    result = "\n".join(sorted(entries))
                else:
                    if not stat.S_ISREG(info.st_mode) or info.st_nlink > 1:
                        raise ValueError("only regular, non-hardlinked files are allowed")
                    data = os.read(fd, 65537)
                    if len(data) > 65536 or b"\x00" in data:
                        raise ValueError("file too large or binary")
                    result = data.decode("utf-8")
                    if name == "search_text":
                        result = "\n".join(("%d: %s" % (i, line)) for i, line in
                                             enumerate(result.splitlines(), 1) if args["query"] in line)
                        result = "\n".join(result.splitlines()[:100])
                return json.dumps({"result": result[:16000], "untrusted": True}, ensure_ascii=False)
            finally:
                os.close(fd)
        except (OSError, ValueError, TypeError) as e:
            return json.dumps({"error": str(e)})


class _ToolDisplay:
    """Bounded, terminal-safe tool cards; never add UI to piped output."""

    def __init__(self, out, function, color=False):
        self.out = out
        self.function = function
        self.enabled = out_is_tty(out)
        self.color = color and color_enabled(True)
        self.width = max(12, shutil.get_terminal_size((80, 24)).columns - 1)
        self.started = None

    def line(self, prefix, text, style=""):
        # Flatten controls/newlines and bound by terminal cells, not codepoints.
        text = " ".join(safe_terminal(str(text)).split())
        budget = max(1, self.width - len(prefix))
        clipped, cells = [], 0
        for char in text:
            size = 0 if unicodedata.combining(char) else (2 if unicodedata.east_asian_width(char) in "WF" else 1)
            if cells + size > budget - 1:
                clipped.append("…")
                break
            clipped.append(char)
            cells += size
        line = prefix + "".join(clipped)
        self.out.write((style + line + _A_RST if self.color else line) + "\n")
        self.out.flush()

    def __enter__(self):
        self.started = time.monotonic()
        if self.enabled:
            self.line("┌─ ", self.function["name"], _A_DIM)
            try:
                args = json.loads(self.function["arguments"])
            except (ValueError, TypeError):
                args = None
            if isinstance(args, dict):
                for key, value in list(args.items())[:3]:
                    self.line("│ ", "%s: %s" % (key, value))
                if len(args) > 3:
                    self.line("│ ", "… more arguments")
            else:
                self.line("│ ", "Invalid arguments", _A_YELLOW)
            self.line("│ ", "Running…", _A_DIM)
        return self

    def finish(self, result=None, error=None):
        if not self.enabled:
            return
        failed = error is not None
        status = "Error" if failed else "Done"
        preview = str(error) if failed else ""
        if result is not None:
            try:
                data = json.loads(result)
                if not isinstance(data, dict):
                    raise ValueError("unexpected result")
                preview = str(data.get("error", data.get("output", data.get("result", ""))))
                failed = "error" in data or data.get("exit_code", 0) != 0 or bool(data.get("stopped"))
                status = "Error" if failed else "Done"
                if "exit_code" in data:
                    status += " · exit %s" % data["exit_code"]
                if data.get("stopped"):
                    status += " · %s" % data["stopped"]
            except (ValueError, TypeError):
                preview = str(result)
        lines = safe_terminal(preview).splitlines()
        for line in lines[:5]:
            self.line("│ ", line)
        if len(lines) > 5:
            self.line("│ ", "… %d more lines (full result sent to model)" % (len(lines) - 5), _A_DIM)
        if not lines and not failed:
            self.line("│ ", "(no output)", _A_DIM)
        self.line("└─ ", "%s %s · %.1fs" % ("✗" if failed else "✓", status,
                  time.monotonic() - self.started), _A_YELLOW if failed else _A_GREEN)

    def __exit__(self, exc_type, exc, tb):
        if exc is not None:
            self.finish(error="Interrupted" if isinstance(exc, KeyboardInterrupt) else str(exc))


def tool_complete(base, api_key, model, messages, timeout, temp, max_tok,
                  stream, out, render, runner):
    work = list(messages)
    for turn in range(33):
        if stream:
            fw = _FrameWriter(out, "🤖 · %s" % safe_terminal(model)) if render else out
            try:
                reply = waiting_stream(base, api_key, model, work, timeout, temp,
                                       max_tok, fw, _MdLive() if render else None, runner.schemas)
            finally:
                if render:
                    fw.end()
        else:
            with _Waiting(out):
                reply = request_once(base, api_key, model, work, timeout, temp, max_tok, runner.schemas)
            if reply.get("content"):
                text = reply["content"]
                if render:
                    text = frame_answer(render_markdown(safe_terminal(text)), "🤖 · %s" % safe_terminal(model))
                elif out_is_tty(out):
                    text = safe_terminal(text)
                out.write(text + "\n")
                out.flush()
        calls = reply.get("tool_calls", [])
        if not calls:
            messages.extend(work[len(messages):])
            return reply["content"]
        if turn == 32:
            raise AIError("tool round limit reached (32)")
        work.append(reply)
        for call in calls:
            function = call["function"]
            with _ToolDisplay(out, function, render) as display:
                result = runner.execute(function["name"], function["arguments"])
                display.finish(result)
            work.append({"role": "tool", "tool_call_id": call["id"], "content": result})
    raise AIError("tool round limit reached")


def request_once(base, api_key, model, messages, timeout, temp, max_tok, tools=None):
    payload = {"model": model, "messages": messages, "stream": False}
    if tools is not None:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"
    if temp is not None:
        payload["temperature"] = temp
    if max_tok is not None:
        payload["max_tokens"] = max_tok
    with post_json(base + "/chat/completions", payload, api_key, timeout) as r:
        try:
            obj = json.loads(r.read().decode("utf-8"))
        except (ValueError, UnicodeDecodeError) as e:
            raise AIError("bad JSON response: %s" % e) from e
    try:
        choice = obj["choices"][0]
        if not isinstance(choice, dict):
            raise TypeError("choice must be an object")
        if choice.get("finish_reason") == "length":
            raise AIError("response truncated by token limit; increase --max-tokens; answer not saved")
        if choice.get("finish_reason") == "content_filter":
            raise AIError("response blocked by content filter; answer not saved")
        message = choice["message"]
        if tools is not None:
            return validate_assistant(message)
        content = message["content"]
        if not isinstance(content, str):
            raise TypeError("message content is not text")
        return content
    except (KeyError, IndexError, TypeError) as e:
        raise AIError("unexpected chat response") from e


def list_models(base, api_key, timeout):
    """GET {base}/models, return sorted ids or None on error."""
    req = urllib.request.Request(
        base + "/models",
        headers={"Authorization": "Bearer " + api_key},
        method="GET",
    )
    try:
        with open_request(req, timeout) as r:
            obj = json.loads(r.read().decode("utf-8"))
    except (AIError, ValueError, OSError, http.client.HTTPException) as e:
        print("dani-ai: models: %s" % safe_terminal(str(e)), file=sys.stderr)
        return None
    try:
        ids = [m["id"] for m in obj["data"]]
        if not all(isinstance(mid, str) for mid in ids):
            raise TypeError("model ids must be strings")
        return sorted(ids)
    except (KeyError, TypeError):
        print("dani-ai: models unexpected response", file=sys.stderr)
        return None


def request_stream(base, api_key, model, messages, timeout, temp, max_tok, out,
                   live=None, tools=None):
    payload = {"model": model, "messages": messages, "stream": True}
    if tools is not None:
        payload["tools"] = tools
        payload["tool_choice"] = "auto"
    if temp is not None:
        payload["temperature"] = temp
    if max_tok is not None:
        payload["max_tokens"] = max_tok
    full = []
    calls = {}
    done = False
    pending_line = ""
    sanitizer = TerminalSanitizer() if live is not None or out_is_tty(out) else None
    with post_json(base + "/chat/completions", payload, api_key, timeout) as r:
        for raw in r:
            text = raw.decode("utf-8", "replace").strip()
            if not text or text.startswith(":") or text.startswith(("event:", "id:", "retry:")):
                continue
            if not text.startswith("data:"):
                raise AIError("unexpected stream event")
            data = text[5:].strip()
            if data == "[DONE]":
                done = True
                break
            try:
                obj = json.loads(data)
                if not isinstance(obj, dict) or "error" in obj:
                    raise ValueError("API stream error")
                choices = obj["choices"]
                if not isinstance(choices, list):
                    raise ValueError("invalid choices")
                if not choices:  # optional usage-only event
                    continue
                finish_reason = choices[0].get("finish_reason")
                if finish_reason == "length":
                    raise AIError("response truncated by token limit; increase --max-tokens; partial answer not saved")
                if finish_reason == "content_filter":
                    raise AIError("response blocked by content filter; partial answer not saved")
                chunk = choices[0].get("delta", {})
                if tools is not None:
                    for call in chunk.get("tool_calls", []):
                        index = call["index"]
                        if not isinstance(index, int) or not 0 <= index < 16:
                            raise ValueError("invalid tool index")
                        target = calls.setdefault(index, {"id": "", "type": "function",
                                                         "function": {"name": "", "arguments": ""}})
                        if "id" in call:
                            target["id"] += call["id"]
                        for key in ("name", "arguments"):
                            target["function"][key] += call.get("function", {}).get(key, "")
                        if len(target["function"]["arguments"]) > 65536:
                            raise ValueError("tool arguments too large")
                delta = chunk.get("content", "")
                if delta is None:
                    delta = ""
                if not isinstance(delta, str):
                    raise ValueError("non-text delta")
            except (ValueError, KeyError, IndexError, TypeError, AttributeError) as e:
                raise AIError("invalid or error stream event") from e
            if delta:
                full.append(delta)
                visible = sanitizer.feed(delta) if sanitizer else delta
                if live is not None:
                    # SSE chunks can split any Markdown delimiter. Render complete
                    # lines, preserving fence state, rather than isolated tokens.
                    pending_line += visible
                    while "\n" in pending_line:
                        line, pending_line = pending_line.split("\n", 1)
                        out.write(live.render(line) + "\n")
                else:
                    out.write(visible)
                out.flush()
    if not done:
        raise AIError("stream interrupted before [DONE]; partial answer not saved")
    if full or tools is None:
        # Tool-call-only rounds produce no text: do not emit a blank line.
        if live is not None and pending_line:
            out.write(live.render(pending_line))
        out.write("\n")
        out.flush()
    if tools is not None:
        message = {"role": "assistant", "content": "".join(full) or None}
        if calls:
            message["tool_calls"] = [calls[i] for i in sorted(calls)]
        return validate_assistant(message)
    return "".join(full)


def out_is_tty(out):
    return bool(getattr(out, "isatty", lambda: False)())


class TerminalSanitizer:
    """Strip terminal controls, retaining state across streamed chunks."""
    def __init__(self):
        self.state = "text"

    def feed(self, text):
        result = []
        for c in text:
            if self.state == "esc":
                if c == "[":
                    self.state = "csi"
                elif c in "]PX^_":
                    self.state = "string"
                elif " " <= c <= "/":
                    self.state = "escape-intermediate"
                else:
                    self.state = "text"
            elif self.state == "escape-intermediate":
                if "0" <= c <= "~":
                    self.state = "text"
            elif self.state == "csi":
                if "@" <= c <= "~":
                    self.state = "text"
            elif self.state == "string":
                if c in ("\x07", "\x9c"):
                    self.state = "text"
                elif c == "\x1b":
                    self.state = "string-esc"
            elif self.state == "string-esc":
                self.state = "text" if c == "\\" else "string"
            elif c == "\x1b":
                self.state = "esc"
            elif c == "\x9b":
                self.state = "csi"
            elif c in ("\x90", "\x9d", "\x98", "\x9e", "\x9f"):
                self.state = "string"
            elif c in "\n\t" or unicodedata.category(c) not in ("Cc", "Cf", "Cs"):
                result.append(c)
        return "".join(result)


def safe_terminal(text):
    return TerminalSanitizer().feed(text)


class _Waiting:
    """TTY-only progress indicator; stop and join before writing response text."""

    def __init__(self, out):
        self.out = out
        self.enabled = out_is_tty(out)
        self.stopped = threading.Event()
        self.thread = None

    def __enter__(self):
        if self.enabled:
            self.out.write("\r⠋ Waiting for response…")
            self.out.flush()
            self.thread = threading.Thread(target=self._animate, daemon=True)
            self.thread.start()
        return self

    def _animate(self):
        frames = "⠙⠹⠸⠼⠴⠦⠧⠇⠏⠋"
        i = 0
        while not self.stopped.wait(0.1):
            try:
                self.out.write("\r%s Waiting for response…" % frames[i % len(frames)])
                self.out.flush()
            except OSError:
                return
            i += 1

    def stop(self):
        if self.stopped.is_set():
            return
        self.stopped.set()
        if self.thread is not None:
            self.thread.join()
        if self.enabled:
            self.out.write("\r" + " " * 28 + "\r")
            self.out.flush()

    def __exit__(self, *exc):
        self.stop()

    def isatty(self):
        return self.enabled

    def write(self, text):
        if text:
            self.stop()
        return self.out.write(text)

    def flush(self):
        self.out.flush()


def waiting_stream(base, api_key, model, messages, timeout, temp, max_tok, out,
                   live=None, tools=None):
    # Animate on the underlying terminal, not through the frame line writer.
    terminal = out.out if isinstance(out, _FrameWriter) else out
    with _Waiting(terminal) as waiting:
        class Writer:
            def isatty(self):
                return out_is_tty(out)

            def write(self, text):
                if text:
                    waiting.stop()
                return out.write(text)

            def flush(self):
                out.flush()
        return request_stream(base, api_key, model, messages, timeout, temp,
                              max_tok, Writer(), live, tools)


def complete(base, api_key, model, messages, timeout, temp, max_tok, stream, out,
               render=False, runner=None):
    if runner is not None and runner.schemas:
        return tool_complete(base, api_key, model, messages, timeout, temp,
                             max_tok, stream, out, render, runner)
    if render:
        title = "🤖 · %s" % model
        if stream:
            fw = _FrameWriter(out, title)
            try:
                return waiting_stream(base, api_key, model, messages, timeout, temp,
                                      max_tok, fw, _MdLive())
            finally:
                fw.end()
        with _Waiting(out):
            raw = request_once(base, api_key, model, messages, timeout, temp, max_tok)
        out.write(frame_answer(render_markdown(safe_terminal(raw)), safe_terminal(title)) + "\n")
        out.flush()
        return raw
    if stream:
        return waiting_stream(base, api_key, model, messages, timeout, temp, max_tok, out)
    with _Waiting(out):
        text = request_once(base, api_key, model, messages, timeout, temp, max_tok)
    out.write(safe_terminal(text) if out_is_tty(out) else text)
    if not text.endswith("\n"):
        out.write("\n")
    out.flush()
    return text


# ---- minimal markdown -> ANSI (TTY only, stdlib) ----

_A_B = "\x1b[1m"
_A_DIM = "\x1b[2m"
_A_ITAL = "\x1b[3m"
_A_CYAN = "\x1b[36m"
_A_GREEN = "\x1b[32m"
_A_YELLOW = "\x1b[33m"
_A_MAG = "\x1b[35m"
_A_RST = "\x1b[0m"


def render_inline(s):
    codes = []

    def stash(m):
        codes.append(m.group(1))
        return "\x00%d\x00" % (len(codes) - 1)

    s = re.sub(r"`([^`\n]+)`", stash, s)
    s = re.sub(r"\*\*([^*]+)\*\*", _A_B + r"\1" + _A_RST, s)
    s = re.sub(r"(?<!\w)\*([^*]+)\*(?!\w)", _A_ITAL + r"\1" + _A_RST, s)
    s = re.sub(r"(?<!\w)_([^_]+)_(?!\w)", _A_ITAL + r"\1" + _A_RST, s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
               _A_B + r"\1" + _A_RST + _A_DIM + r" (\2)" + _A_RST, s)
    for i, c in enumerate(codes):
        s = s.replace("\x00%d\x00" % i, _A_GREEN + c + _A_RST)
    return s


class _MdLive:
    """Stateful line renderer: keeps code-fence state across streamed lines."""

    def __init__(self):
        self.fence = False

    def render(self, line):
        s = line
        if s.strip().startswith("```"):
            self.fence = not self.fence
            return _A_DIM + ("─" * 24) + _A_RST
        if self.fence:
            return _A_CYAN + s + _A_RST if s else s
        m = re.match(r"^(#{1,6})\s+(.*)$", s)
        if m:
            color = _A_YELLOW if len(m.group(1)) <= 2 else _A_MAG
            return _A_B + color + render_inline(m.group(2)) + _A_RST
        m = re.match(r"^(\s*)[-*+]\s+(.*)$", s)
        if m:
            return (m.group(1) + _A_YELLOW + "•" + _A_RST + " " +
                    render_inline(m.group(2)))
        m = re.match(r"^(\s*)(\d+[.)])\s+(.*)$", s)
        if m:
            return (m.group(1) + _A_YELLOW + m.group(2) + _A_RST + " " +
                    render_inline(m.group(3)))
        m = re.match(r"^\s*>\s?(.*)$", s)
        if m:
            return _A_DIM + "│ " + render_inline(m.group(1)) + _A_RST
        if re.match(r"^\s*(-{3,}|\*{3,}|_{3,})\s*$", s):
            return _A_DIM + ("─" * 24) + _A_RST
        return render_inline(s)


def render_markdown(text):
    live = _MdLive()
    return "\n".join(live.render(ln) for ln in text.split("\n"))


def color_enabled(cli_color):
    if not cli_color:
        return False
    if "NO_COLOR" in os.environ:
        return False
    return sys.stdout.isatty()


# ---- chat frames (TTY only): boxed input + boxed answer ----

def term_width():
    try:
        return max(40, min(shutil.get_terminal_size().columns, 88))
    except OSError:
        return 70


def _frame_head(title, width):
    return (_A_DIM + ("┌─ %s " % title).ljust(width, "─") + _A_RST)


def _frame_foot(width):
    return _A_DIM + ("└" + "─" * (width - 1)) + _A_RST


def _frame_line(ln):
    # Keep answer text selectable without copying decorative gutters.
    return ln


def frame_answer(text, title, width=None):
    w = width or term_width()
    lines = [_frame_head(title, w)]
    lines += [_frame_line(ln) for ln in text.split("\n")]
    lines.append(_frame_foot(w))
    return "\n".join(lines)


class _FrameWriter:
    """Stream answer text between separators, without a copy-polluting gutter."""

    def __init__(self, out, title, width=None):
        self.out = out
        self.at_line_start = True
        w = width or term_width()
        self.head = _frame_head(safe_terminal(title), w)
        self.foot = _frame_foot(w)
        self.opened = False
        self.pending = ""

    def isatty(self):
        return out_is_tty(self.out)

    def write(self, s):
        if not s:
            return
        if not self.opened:
            self.pending += s
            if not self.pending.strip():
                return
            self.out.write(self.head + "\n")
            self.opened = True
            s, self.pending = self.pending, ""
        self.out.write(s)
        self.at_line_start = s.endswith("\n")
        self.out.flush()

    def flush(self):
        self.out.flush()

    def end(self):
        if not self.opened:
            self.pending = ""
            return
        if not self.at_line_start:
            self.out.write("\n")
        self.out.write(self.foot + "\n")
        self.out.flush()


MAX_CLIPBOARD_BYTES = 10 * 1024 * 1024
_INPUT_IMAGES = []


def clipboard_read_command(command, limit=MAX_CLIPBOARD_BYTES):
    """Bound clipboard reads by size and time; never invoke a shell."""
    with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL) as proc:
        try:
            data = bytearray()
            deadline = time.monotonic() + 3
            with selectors.DefaultSelector() as sel:
                sel.register(proc.stdout, selectors.EVENT_READ)
                while True:
                    remaining = deadline - time.monotonic()
                    if remaining <= 0 or not sel.select(remaining):
                        raise AIError("clipboard timed out")
                    chunk = os.read(proc.stdout.fileno(), min(65536, limit + 1 - len(data)))
                    if not chunk:
                        break
                    data.extend(chunk)
                    if len(data) > limit:
                        raise AIError("clipboard exceeds size limit")
            if proc.wait(timeout=max(0.01, deadline - time.monotonic())):
                raise AIError("cannot read clipboard")
            return bytes(data)
        finally:
            if proc.poll() is None:
                proc.kill()
                proc.wait()


def read_clipboard():
    if os.environ.get("WAYLAND_DISPLAY") and shutil.which("wl-paste"):
        targets = clipboard_read_command(["wl-paste", "--list-types"], 65536).decode().splitlines()
        command = lambda mime: ["wl-paste", "--no-newline", "--type", mime]
    elif os.environ.get("DISPLAY") and shutil.which("xclip"):
        targets = clipboard_read_command(["xclip", "-selection", "clipboard", "-o", "-t", "TARGETS"], 65536).decode().splitlines()
        command = lambda mime: ["xclip", "-selection", "clipboard", "-o", "-t", mime]
    else:
        raise AIError("Ctrl+V needs xclip (X11) or wl-paste (Wayland)")
    signatures = {"image/png": lambda b: b.startswith(b'\x89PNG\r\n\x1a\n'),
                  "image/jpeg": lambda b: b.startswith(b'\xff\xd8\xff'),
                  "image/gif": lambda b: b.startswith((b'GIF87a', b'GIF89a')),
                  "image/webp": lambda b: b.startswith(b'RIFF') and b[8:12] == b'WEBP'}
    for mime, valid in signatures.items():
        if mime in targets:
            data = clipboard_read_command(command(mime))
            if not valid(data):
                raise AIError("invalid clipboard image")
            return "image", "data:%s;base64,%s" % (mime, base64.b64encode(data).decode("ascii"))
    for mime in ("text/plain;charset=utf-8", "UTF8_STRING", "text/plain", "STRING"):
        if mime in targets:
            return "text", safe_terminal(clipboard_read_command(command(mime)).decode("utf-8", "replace"))
    raise AIError("clipboard has no supported image or text")


def attached_content(text):
    images = []
    for marker, url in _INPUT_IMAGES:
        if marker in text:
            text = text.replace(marker, "")
            images.append({"type": "image_url", "image_url": {"url": url}})
    if not images:
        return text
    return ([{"type": "text", "text": text.strip()}] if text.strip() else []) + images


@contextlib.contextmanager
def clipboard_key():
    """Temporarily bind GNU readline Ctrl+V, keeping editing/history intact."""
    if _rl is None or not sys.stdin.isatty() or "libedit" in (_rl.__doc__ or ""):
        yield
        return
    try:
        lib = ctypes.CDLL(_rl.__file__)
        callback_type = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_int, ctypes.c_int)
        lib.rl_function_of_keyseq.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
        lib.rl_function_of_keyseq.restype = ctypes.c_void_p
        lib.rl_bind_key.argtypes = [ctypes.c_int, ctypes.c_void_p]
        lib.rl_insert_text.argtypes = [ctypes.c_char_p]
        kind = ctypes.c_int()
        original = lib.rl_function_of_keyseq(b'\x16', None, ctypes.byref(kind))
        if kind.value != 0:
            raise ValueError("Ctrl+V is not bound to a function")
    except (AttributeError, OSError, ValueError):
        yield
        return

    @callback_type
    def paste(count, key):
        try:
            typ, value = read_clipboard()
            if typ == "image":
                marker = "[Image %d]" % (len(_INPUT_IMAGES) + 1)
                _INPUT_IMAGES.append((marker, value))
                value = marker
            lib.rl_insert_text(value.encode("utf-8"))
        except Exception as e:
            print("\n(clipboard: %s)" % safe_terminal(str(e)), flush=True)
            lib.rl_on_new_line()
        lib.rl_redisplay()
        return 0

    # Python initializes readline on the first input(), resetting bindings.
    # Install our binding in the startup hook, after that initialization.
    def bind():
        # Python disables this by default. Without bracketed paste, newlines
        # supplied by the terminal are interpreted as accept-line (Enter).
        _rl.parse_and_bind("set enable-bracketed-paste on")
        lib.rl_bind_key(22, ctypes.cast(paste, ctypes.c_void_p))
    _rl.set_startup_hook(bind)
    try:
        yield
    finally:
        _rl.set_startup_hook(None)
        lib.rl_bind_key(22, original)


def input_boxed(color=True):
    if _rl is not None and sys.stdin.isatty() and "libedit" not in (_rl.__doc__ or ""):
        _rl.parse_and_bind("set enable-bracketed-paste on")
    with clipboard_key():
        if not color or not sys.stdout.isatty():
            return input("> ")
        w = term_width()
        print(_A_DIM + ("┌─ 👤 ".ljust(w, "─")) + _A_RST)
        return input("\001" + _A_B + _A_GREEN + "\002└─❯ " + "\001" + _A_RST + "\002")


# ---- REPL slash-command completion + hints (readline, stdlib) ----

COMMANDS = [
    "/base", "/clear", "/color", "/exit", "/help", "/model",
    "/new", "/q", "/quit", "/reset", "/resume", "/root", "/save", "/shell", "/stream", "/system",
]


def suggest_command(text):
    if not text.startswith("/"):
        return None
    if text == "/":
        return "commands: " + " ".join(COMMANDS)
    matches = [c for c in COMMANDS if c.startswith(text)]
    if text in COMMANDS or not matches:
        return None
    if len(matches) == 1:
        return "did you mean %s?" % matches[0]
    return "did you mean: " + " ".join(matches)


def complete_token(hist_dir, buf, text, state):
    """Pure completer core (testable without a live readline session)."""
    if buf.startswith(("/save ", "/resume ")):
        try:
            names = [f[:-5] for f in os.listdir(hist_dir)
                     if f.endswith(".json")]
        except OSError:
            names = []
        opts = sorted(n for n in names if n.startswith(text))
    elif text.startswith("/"):
        opts = sorted(c for c in COMMANDS if c.startswith(text))
    else:
        return None
    if state < len(opts):
        return opts[state]
    return None


def setup_readline(hist_dir):
    """Tab completion + arrow-up history. Returns history file or ''."""
    if _rl is None:
        return ""
    try:
        _rl.set_completer_delims(" \t\n")
        _rl.set_completer(
            lambda text, state: complete_token(
                hist_dir, _rl.get_line_buffer(), text, state))
        _rl.parse_and_bind("tab: complete")
        _rl.set_history_length(200)
        if hasattr(_rl, "set_auto_history"):
            _rl.set_auto_history(True)
        hf = os.path.join(hist_dir, ".repl_history")
        try:
            _rl.read_history_file(hf)
        except OSError:
            pass
        return hf
    except Exception:
        return ""


def read_piped_stdin():
    if sys.stdin.isatty():
        return ""
    try:
        data = sys.stdin.read()
    except OSError:
        return ""
    return data.strip()


def repl(base, api_key, model, system, timeout, temp, max_tok, stream, color,
         hist_dir, initial=None, runner=None):
    if initial is not None:
        model, messages = initial
        messages = list(messages)
        if system:
            messages = [m for m in messages if m["role"] != "system"]
            messages.insert(0, {"role": "system", "content": system})
        else:
            system = next((m["content"] for m in messages if m["role"] == "system"), "")
        n = len([m for m in messages if m["role"] != "system"])
        print("(resumed %d messages, model=%s)" % (n, safe_terminal(model)))
    else:
        messages = []
        if system:
            messages.append({"role": "system", "content": system})
    print("dani-ai chat (%s). /help for commands, Tab completes, Ctrl+Shift+V pastes text (Enter to send), Ctrl+V pastes text/images, Ctrl-D to quit."
          % safe_terminal(model))
    histfile = setup_readline(hist_dir)
    try:
        while True:
            try:
                _INPUT_IMAGES.clear()
                line = input_boxed(color)
            except EOFError:
                print("")
                break
            except KeyboardInterrupt:
                print("")
                break
            s = line.strip()
            if not s:
                continue
            if s in ("/quit", "/exit", "/q"):
                break
            if s in ("/reset", "/clear", "/new"):
                if s == "/clear" and sys.stdout.isatty():
                    # Clear visible screen and scrollback, then move to top-left.
                    print("\x1b[2J\x1b[3J\x1b[H", end="", flush=True)
                messages = [{"role": "system", "content": system}] if system else []
                print("(new session)" if s == "/clear" else "(history cleared)")
                continue
            if s in ("/help", "/h", "/?"):
                print("/reset clear history  /system <text> set system  /model select model  /base <url>")
                print("/clear clear terminal + new session  /new new session")
                print("/save [name] (no name = AI title)  /resume [name] (no name = picker)")
                print("/stream on|off  /color on|off  /quit")
                print("/root [directory] show/change tool root (supports ~; no shell needed)")
                print("/shell on|off enable/disable UNSANDBOXED shell for this session (allows Git commit/push)")
                print("Commands: /reset /system /model /base /root /save /resume /stream /color /quit")
                continue
            if s == "/save" or s.startswith("/save "):
                name = s[len("/save"):].strip()
                automatic = not name
                if automatic:
                    try:
                        with _Waiting(sys.stdout):
                            name = suggest_session_name(base, api_key, model, messages, timeout)
                    except KeyboardInterrupt:
                        print("\n(save cancelled)")
                        continue
                safe = re.sub(r"[^A-Za-z0-9_-]+", "-", name).strip("-") or "chat"
                if automatic:
                    stem, suffix = safe, 2
                    while os.path.exists(os.path.join(hist_dir, safe + ".json")):
                        safe = "%s-%d" % (stem, suffix)
                        suffix += 1
                if save_session(os.path.join(hist_dir, safe + ".json"), model,
                                messages):
                    print("(saved %s)" % safe)
                continue
            if s == "/resume" or s.startswith("/resume "):
                name = s[len("/resume"):].strip()
                if not name:
                    try:
                        names = sorted(f[:-5] for f in os.listdir(hist_dir)
                                       if f.endswith(".json") and
                                       re.fullmatch(r"[A-Za-z0-9_-]+", f[:-5]))
                    except OSError:
                        names = []
                    if not names:
                        print("(no saved sessions)")
                        continue
                    for i, saved in enumerate(names, 1):
                        print("%d. %s" % (i, saved))
                    try:
                        pick = input("session # or name (Enter = cancel): ").strip()
                    except (EOFError, KeyboardInterrupt):
                        print("")
                        continue
                    if not pick:
                        continue
                    name = names[int(pick) - 1] if pick.isdigit() and 1 <= int(pick) <= len(names) else pick
                if not re.fullmatch(r"[A-Za-z0-9_-]+", name):
                    print("(invalid session name; use letters, numbers, _ or -)")
                    continue
                loaded_model, loaded_messages = load_session(os.path.join(hist_dir, name + ".json"))
                if loaded_messages is None:
                    continue
                model = loaded_model or model
                messages = loaded_messages
                system = next((m["content"] for m in messages if m["role"] == "system"), "")
                count = sum(m["role"] != "system" for m in messages)
                print("(resumed %s: %d messages, model=%s)" % (name, count, safe_terminal(model)))
                continue
            if s == "/system" or s.startswith("/system "):
                messages = [m for m in messages if m["role"] != "system"]
                new_sys = s[len("/system"):].strip()
                if new_sys:
                    system = new_sys
                    messages.insert(0, {"role": "system", "content": system})
                    print("(system updated)")
                else:
                    system = ""
                    print("(system cleared)")
                continue
            if s == "/model":
                ids = list_models(base, api_key, timeout)
                if not ids:
                    continue
                for i, mid in enumerate(ids, 1):
                    print("%d. %s" % (i, safe_terminal(mid)))
                try:
                    pick = input("model # or name (Enter = keep %s): " % safe_terminal(model)).strip()
                except (EOFError, KeyboardInterrupt):
                    print("")
                    continue
                if not pick:
                    print("model = %s" % safe_terminal(model))
                elif pick.isdigit() and 1 <= int(pick) <= len(ids):
                    model = ids[int(pick) - 1]
                    print("(model = %s)" % safe_terminal(model))
                else:
                    model = pick
                    print("(model = %s)" % safe_terminal(model))
                continue
            if s.startswith("/model "):
                model = s[len("/model"):].strip()
                print("(model = %s)" % safe_terminal(model))
                continue
            if s == "/shell" or s.startswith("/shell "):
                if runner is None:
                    print("(tools disabled; restart without --no-tools)")
                    continue
                arg = s[len("/shell"):].strip().lower()
                if arg not in ("", "on", "off"):
                    print("usage: /shell on|off")
                    continue
                if arg:
                    runner.set_shell(arg == "on")
                enabled = not runner.is_blocked("run_command")
                print("(shell %s)" % ("on: UNSANDBOXED user privileges, network and paths outside root" if enabled else "off; blocklist still applies"))
                continue
            if s == "/root" or s.startswith("/root "):
                if runner is None:
                    print("(tools disabled; restart without --no-tools)")
                    continue
                directory = s[len("/root"):].strip()
                if directory:
                    try:
                        candidate = Path(directory).expanduser()
                        if not candidate.is_absolute():
                            candidate = runner.root / candidate
                        candidate = candidate.resolve(strict=True)
                        if not candidate.is_dir():
                            raise ValueError("tool root must be a directory")
                        previous = runner.root
                        runner.root = candidate
                        if candidate != previous:
                            # Tool outputs in the previous conversation describe
                            # another filesystem context. Do not let the model
                            # edit the new project based on stale file contents.
                            messages = [{"role": "system", "content": system}] if system else []
                            print("(tool root changed; conversation cleared to avoid stale file context)")
                    except (OSError, ValueError, RuntimeError) as e:
                        print("(cannot change root: %s)" % safe_terminal(str(e)))
                        continue
                print("tool_root = %s" % safe_terminal(str(runner.root)))
                continue
            if s == "/base" or s.startswith("/base "):
                url = s[len("/base"):].strip()
                if url:
                    base = url.rstrip("/")
                    print("(base = %s)" % base)
                else:
                    print("base = %s" % base)
                continue
            if s == "/stream" or s.startswith("/stream "):
                arg = s[len("/stream"):].strip().lower()
                if arg in ("on", "1", "true"):
                    stream = True
                elif arg in ("off", "0", "false"):
                    stream = False
                print("(stream %s)" % ("on" if stream else "off"))
                continue
            if s == "/color" or s.startswith("/color "):
                arg = s[len("/color"):].strip().lower()
                if arg in ("on", "1", "true"):
                    color = True
                elif arg in ("off", "0", "false"):
                    color = False
                print("(color %s)" % ("on" if color else "off"))
                continue
            if s.startswith("/"):
                hint = suggest_command(s)
                print(hint or "unknown command. /help")
                continue
            messages.append({"role": "user", "content": attached_content(s)})
            try:
                reply = complete(base, api_key, model, messages, timeout, temp, max_tok,
                                 stream, sys.stdout, color, runner)
            except BrokenPipeError:
                messages.pop()
                break
            except (AIError, OSError, ValueError, http.client.HTTPException) as e:
                messages.pop()  # failed turn must not contaminate future requests
                print("\ndani-ai: %s" % safe_terminal(str(e)), file=sys.stderr)
                continue
            except KeyboardInterrupt:
                messages.pop()
                print("\n(request cancelled)", file=sys.stderr)
                continue
            messages.append({"role": "assistant", "content": reply})
    finally:
        if has_content(messages):
            try:
                if save_session(os.path.join(hist_dir, "last.json"), model, messages):
                    print("(auto-saved, --continue to resume)")
            except (BrokenPipeError, OSError):
                pass
        if histfile and _rl is not None:
            try:
                atomic_private_write(histfile, _rl.write_history_file)
            except Exception:
                pass


def confirm_tool(name, description):
    """Ask the user before running a custom tool; False when no TTY."""
    try:
        # Separate handles: /dev/tty cannot be opened "r+" with line buffering.
        writer = open("/dev/tty", "w")
        reader = open("/dev/tty", "r")
    except OSError:
        return False
    try:
        writer.write("\n⚠ dani-ai muon chay custom tool '%s'\n  %s\n  Cho phep? [y/N] "
                     % (safe_terminal(name), " ".join(safe_terminal(description).split())[:200]))
        writer.flush()
        answer = reader.readline().strip().lower()
        return answer in ("y", "yes")
    except (OSError, KeyboardInterrupt):
        return False
    finally:
        reader.close()
        writer.close()


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.timeout <= 0 or not math.isfinite(args.timeout):
        parser.error("--timeout must be finite and positive")
    if args.max_tokens is not None and args.max_tokens <= 0:
        parser.error("--max-tokens must be positive")
    if args.temperature is not None and not math.isfinite(args.temperature):
        parser.error("--temperature must be finite")
    if args.version:
        print("dani-ai " + VERSION)
        return 0
    api_key, key_source = resolve_key(args.api_key)
    file_base, file_model = "", ""
    if key_source and key_source != "--api-key" and key_source not in KEY_ENVS:
        _, file_base, file_model, _ = read_key_file()
    base, base_source = resolve_base(args.api_base, key_source, file_base)
    system, system_source = resolve_system(args.system, args.system_file)
    hist = history_dir()
    runner = None
    if not args.no_tools:
        runner = ToolRunner(args.tool_root, args.block_tool, args.tool_blocklist,
                            None if args.no_custom_tools
                            else (args.tools_dir or tools_dir_default()),
                            None if args.yes_tools else confirm_tool,
                            allow_shell=args.allow_shell)
    saved_model, saved_msgs = "", None
    if args.cont is not None:
        name = args.cont if args.cont.endswith(".json") else args.cont + ".json"
        saved_model, saved_msgs = load_session(os.path.join(hist, name))
        if saved_msgs is None:
            return 1
    if args.model:
        model, model_source = args.model, "--model"
    elif saved_model:
        model, model_source = saved_model, "history"
    else:
        model, model_source = resolve_model("", base, file_model)
    if args.show_config:
        if not api_key:
            masked = "(empty)"
        elif len(api_key) > 4:
            masked = "•••" + api_key[-4:]
        else:
            masked = "•••(set)"
        print("api_base = %s  (%s)" % (base, base_source))
        print("model = %s  (%s)" % (model, model_source))
        print("key = %s  (%s)" % (masked, key_source or "missing"))
        print("tools = %s" % (", ".join(s["function"]["name"] for s in runner.schemas)
                                if runner and runner.schemas else "(disabled)"))
        if runner:
            print("tool_root = %s" % runner.root)
            print("custom_tools = %s" % (", ".join(sorted(runner.custom)) or "(none)"))
            if runner.custom_dir:
                print("tools_dir = %s" % runner.custom_dir)
            for problem in runner.custom_errors:
                print("tool_manifest_error = %s" % problem)
            print("blocked_tools = %s" % (", ".join(runner.blocked) or "(none)"))
        print("system = %s" % (system_source or "(none)"))
        if system:
            print("--- system preview ---")
            print(system[:300])
        return 0
    words = list(args.prompt)
    if len(words) == 1 and words[0] == "tools":
        if not runner:
            print("(tools disabled)")
            return 0
        for schema in runner.schemas:
            function = schema["function"]
            source = "custom" if function["name"] in runner.custom else "builtin"
            print(safe_terminal("%-16s %-8s %s" % (function["name"], source,
                                                   function["description"][:90])))
        for problem in runner.custom_errors:
            print(safe_terminal("! skipped: %s" % problem), file=sys.stderr)
        if runner.custom_dir:
            print("manifests: %s" % runner.custom_dir)
        return 0
    if not api_key:
        print("dani-ai: missing API key. Set DANI_AI_API_KEY (or OPENAI_API_KEY /",
              file=sys.stderr)
        print("  DEEPSEEK_API_KEY), pass --api-key, or save the key as the",
              file=sys.stderr)
        print("  first line of ~/.config/daniwm/ai.key (chmod 600).", file=sys.stderr)
        return 2
    want_chat = args.chat or (len(words) == 1 and words[0] == "chat")
    if want_chat and not args.chat:
        words = []
    render = color_enabled(args.color)
    if len(words) == 1 and words[0] == "models":
        ids = list_models(base, api_key, args.timeout)
        if ids is None:
            return 1
        for mid in ids:
            print(safe_terminal(mid) if sys.stdout.isatty() else mid)
        return 0
    if len(words) == 1 and words[0] == "history":
        try:
            files = [f for f in os.listdir(hist) if f.endswith(".json")]
        except OSError:
            files = []
        files.sort(key=lambda f: os.path.getmtime(os.path.join(hist, f)),
                   reverse=True)
        if not files:
            print("(no saved chats)")
            return 0
        for f in files:
            sm, msgs = load_session(os.path.join(hist, f))
            if msgs is None:
                continue
            first = next((m.get("content", "") for m in msgs
                          if m.get("role") == "user"), "")
            if isinstance(first, list):
                first = " ".join(p.get("text", "[image]") for p in first)
            first = first.replace("\n", " ")[:60]
            n = len([m for m in msgs if m.get("role") != "system"])
            print(safe_terminal("%s  %s  %d msgs  %s" % (f[:-5], sm or "-", n, first)))
        return 0
    initial = None
    if saved_msgs is not None:
        initial = (model, saved_msgs)
    if want_chat:
        repl(base, api_key, model, system, args.timeout,
             args.temperature, args.max_tokens, args.stream, render, hist,
             initial, runner)
        return 0
    piped = read_piped_stdin()
    if not words and not piped:
        repl(base, api_key, model, system, args.timeout,
             args.temperature, args.max_tokens, args.stream, render, hist,
             initial, runner)
        return 0
    prompt = " ".join(words).strip()
    if piped:
        prompt = (prompt + "\n\n" + piped).strip() if prompt else piped
    if not prompt:
        print("dani-ai: empty prompt.", file=sys.stderr)
        return 1
    messages = list(saved_msgs) if saved_msgs is not None else []
    if system:
        messages = [m for m in messages if m["role"] != "system"]
        messages.insert(0, {"role": "system", "content": system})
    messages.append({"role": "user", "content": prompt})
    complete(base, api_key, model, messages, args.timeout,
             args.temperature, args.max_tokens, args.stream, sys.stdout, render, runner)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
    except (AIError, OSError, ValueError, http.client.HTTPException) as e:
        print("dani-ai: %s" % safe_terminal(str(e)), file=sys.stderr)
        sys.exit(1)
