# daniwm config — ~/.config/daniwm/config
# key = value, # comment. Reload nóng bằng Super+Shift+r (không cần restart).
# Dòng bind đầu tiên thay toàn bộ bảng phím mặc định; rule đầu tiên thay rules mặc định.

# ---------- Three-finger swipe (opt-in; set swipe_enabled = 1) ----------
# Up shows overview; down cancels/hides. Left/right select while open,
# otherwise switch workspaces. Super+O also toggles; Enter commits, Esc cancels.
# Requires XI2.4 and verified touchpad delivery; grabs may affect other swipes.
swipe_enabled = 0
swipe_threshold = 80   # finite 1..10000, accumulated XI gesture delta units
swipe_wrap = 0         # stop at first/last workspace
swipe_reverse = 0      # default left=next, right=previous
swipe_debug = 0        # opt-in diagnostic logging to stderr

# ---------- terminal & menu ----------
# Đổi terminal: sửa 1 dòng term = ghostty | kitty | foot | xterm
term = alacritty
menu = dani-run                          # launcher cua nha (drun/fav/power); cu: rofi -show drun
rename_cmd = rofi -dmenu -i -p rename  # prompt của ws_rename (stdout = tên mới;
                                     # $DANIWM_WS_CUR/_NUM dùng được trong cmd;
                                     # Esc = giữ tên cũ, Enter trống = về số)
scratch = alacritty --class scratchpad   # giữ chữ "scratchpad" để toggle tìm được
desktop_click = dani-run --fav           # bấm phải vào desktop trống; bỏ dòng = không làm gì

# ---------- extra binds (giữ nguyên list `bind =` bên dưới) ----------
# `bind =` thay TOÀN BỘ phím mặc định; `bind+` = thêm vào, giữ nguyên.
bind+ = mod+a:exec dani-run --fav
bind+ = mod+Shift+p:exec dani-run --power
# AI chat (dani-ai, BYOK): mo terminal tro chuyen. Key dani-ai doc tu
# ~/.config/daniwm/ai.system, API key qua DANI_AI_API_KEY.
bind+ = mod+Shift+a:exec alacritty -e dani-ai chat
# mod+d (menu) đã có ở list bên dưới, không cần thêm.

# ---------- general ----------
mod = super                          # super | alt | ctrl
workspaces = 7                       # 1..10 — đồng bộ với bspwm (I-VII)
# tên workspace (hiện trên bar + _NET_DESKTOP_NAMES cho pager).
# Dạng khác: "My Web" (giữ space) | 1:Web 2:Code (theo index) | ws_name_1 = Web.
# Thiếu tên = hiện số. Reload nóng Super+Shift+r.
ws_names = chat dev web term trade mics wtf # tên ws1..6, ws7 hiện số
ws_icon_1 =   # icon từng ws (Nerd Font, hiện trước tên trên bar)
ws_icon_2 = 
ws_icon_3 = 
ws_icon_4 = 
ws_icon_5 = 
ws_icon_6 = 
ws_icon_7 = 
mfact = 0.50                        # master chiếm 0.1..0.9 chiều ngang
nmaster = 1                          # số cửa sổ master
border = 1                           # viền mảnh như macOS
border_focus = 0A84FF                # macOS blue (focused)
border_normal = 2C2C2E               # gần như nền (unfocused)
gaps_on = 1
gap_outer = 12
gap_inner = 12
# ---------- dani-comp (compositor của nhà trồng, thay picom) ----------
# Phases 1A/1B: mặc định tắt. Bật compositor=1 + animations=1 để fade-in/out.
# Không chạy đồng thời fastcompmgr/picom trong autostart.sh.
compositor = 0
animations = 0
reduce_motion = 0
animation_open_ms = 140           # số nguyên 0..1000; 0 = instant
animation_close_ms = 100          # close/withdraw only; monocle/scratchpad vẫn instant
animation_layout_ms = 0            # best-effort movement; 0 = instant, mismatch input/visual accepted
animation_workspace_ms = 0         # crossfade khi đổi workspace; 0..250, 0 = instant; input sang ws mới ngay
animation_overview_ms = 0          # overview fade in/out + highlight ô chọn; 0..250, 0 = instant
# Reload cập nhật motion, không start/stop compositor; dùng toggle hoặc startup.
# Chạy tay: dani-comp --wm-settings để nhận config WM (CLI mặc định độc lập).
# Toggle: bind = mod+c:compositor (chỉ dani-comp tương thích trên display này)
bar_on = 1
tray = 1                          # system tray XEmbed ở mép phải bar (1/0)
tray_gap = 8                     # khoảng cách giữa các icon tray (px, 0..32)
bar_h = 32                          # mỏng như menu bar macOS
bar_ws_pad = 12                   # padding chữ 2 bên trong ô workspace có tên (px, 0..32)
ws_w = 36
bar_pad_l = 8
bar_pad_r = 16
# màu bar: hex 6 số, có thể có #. Áp ngay khi reload.
# macOS dark:
bar_bg = 1C1C1E
bar_fg = F5F5F7
bar_acc = 0A84FF
bar_dim = 98989D
# style active ws: pill (default, gọn) | underline | block (khối fill kiểu cũ)
bar_ws_style       = pill
bar_ws_active      = 3A3A3C   # pill của ws đang xem
bar_ws_active_text = FFFFFF   # chữ ws đang xem
bar_ws_occ         = F5F5F7   # chữ workspace có cửa sổ
bar_ws_empty       = 636366   # chữ workspace trống (muted)
bar_urgent         = FF453A   # ws urgent + pin yếu + MUTE (macOS red)
bar_sep            = 2C2C2E   # bottom border (mảnh, tối)
bar_gap            = 2        # spaces giữa các module phải (0..8)
# separator phải (vd: · | / •). Để trống = chỉ cách spaces (kiểu macOS)
bar_sep_str        =
bar_modules        = cpu mem bat vol clock  # thứ tự + ẩn/hiện (xóa tên là ẩn, default đủ: "cpu mem bat vol clock"; máy bàn không pin thì `bat` tự ẩn)
clock_fmt          = %a %d %b  %H:%M  # kiểu macOS: Mon 24 Nov  10:51
bar_show_title     = 1       # tiêu đề cửa sổ đang focus bên trái (1/0)
bar_show_tasks     = 0        # nút task Awesome: click-trái focus, click-giữa đóng (1/0)
bar_task_w         = 280     # rộng mỗi nút task (px, 0 = auto chia đều; vd 160)
bar_task_pad       = 12        # padding chữ trong nút task (px, 0..32)
bar_ws_task_gap    = 32        # vùng chết giữa ws và tasklist + vạch chia (px, 0..64; click vào đây = no-op)
# style task list (khi bar_show_tasks = 1): pill | underline | block | none
bar_task_style        = pill
bar_task_active       = 3A3A3C   # nền task đang focus (= bar_ws_active)
bar_task_active_text  = FFFFFF   # chữ task đang focus
bar_task_text         = 98989D   # chữ task thường; urgent vẫn dùng bar_urgent
bar_show_layout    = 0        # icon tile/monocle + số cửa sổ (1/0)
# icon cụm phải: mặc định là icon Nerd Font (đẹp nhất với font Nerd bên dưới),
# tự rớt về C/M/B/V nếu máy thiếu font. Muốn chữ thường thì mở 3 dòng này:
# ico_cpu = CPU
# ico_vol = VOL
# ico_mem = MEM

bar_mode           = F5F5F7   # số cửa sổ (icon tile/monocle dùng bar_acc)
bar_title          = F5F5F7   # tiêu đề cửa sổ đang focus (sáng như macOS)
bar_sys            = F5F5F7   # giá trị sysmon (icon dùng bar_acc)
bar_cpu_icon       = 30D158   # màu icon từng module (mặc định = bar_acc)
bar_mem_icon       = BF5AF2
bar_bat_icon       = FFD60A
bar_vol_icon       = 0A84FF
bar_clock_icon     = 98989D
# font bar: fontconfig pattern. bar_h=32 hợp với size=9.
font = Noto Sans:size=9          # chữ sans như macOS; icon tự lấy từ Nerd Font
# Không có Nerd Font vẫn đẹp (tự rớt về chữ C/M/B/V).

