# dani-run config — ~/.config/daniwm/run.config
# (symlink to repo: ln -s ~/daniwm/run.config ~/.config/daniwm/run.config)
# key = value, # comment. app=/power= can repeat over lines;
# first line clears defaults (like daniwm bind/rule).

font = SpaceMono Nerd Font:size=13
cols = 4
lines = 8
drun_lines = 12   # rows in drun list mode (3..16, auto-shrinks on short screens)
width = 800      # drun window width (320..1200)
cell_w = 36     # each fav/power grid cell width (80..240)
cell_h = 112     # each fav/power grid cell height (64..200)

# app = icon ; name ; command (split only on first 2 ';', command keeps spaces)
# icon = 1 Nerd Font glyph, empty -> use first letter of the name.
app = ;Brave;brave-browser
app = ;Local;/opt/Local/local
app = ;Slack;slack
app = ;WCVF;alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors'
app = ;WCVP;alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-pro'
app = ;WCVE;alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-engage'
app = ;WCVSU;alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-signup'
app = ;WCV Stripe;alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-gateway-stripe-connect/'

app = ;SaveTo;alacritty -e bash -ic 'zdev ~/wcvdev/saveto-wishlist-lite-for-woocommerce/'

power = ;Lock;loginctl lock-session
power = ;Logout;pkill daniwm
power = ;Reboot;systemctl reboot
power = ;Off;systemctl poweroff
power = ;Suspend;systemctl suspend
