def budget_timeout(timeout):
    deadline = TURN_DEADLINE.get()
    if deadline is not None:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise AIError("total turn deadline exceeded; inspect completed tool results before retrying")
        return min(timeout, remaining)
    return timeout


def request_deadline(timeout):
    return time.monotonic() + budget_timeout(timeout)


class UsageTracker:
    """Provider-reported counts only; missing data is never treated as zero usage."""
    def __init__(self):
        self.requests = 0
        self.reports = 0
        self.totals = {}
        self.coverage = {}
        self.last = None

    def record(self, obj):
        self.requests += 1
        usage = obj.get("usage") if isinstance(obj, dict) else None
        values = {}
        if isinstance(usage, dict):
            for field in ("prompt_tokens", "completion_tokens", "total_tokens"):
                value = usage.get(field)
                if type(value) is int and 0 <= value <= 10**15:
                    values[field] = value
        self.last = values or None
        if values:
            self.reports += 1
        for field, value in values.items():
            self.totals[field] = self.totals.get(field, 0) + value
            self.coverage[field] = self.coverage.get(field, 0) + 1

    def display(self):
        print("usage: %d completed responses, %d with valid provider counts" %
              (self.requests, self.reports))
        for field in ("prompt_tokens", "completion_tokens", "total_tokens"):
            if field in self.totals:
                print("%s: %d (reported in %d/%d responses)" %
                      (field, self.totals[field], self.coverage[field], self.requests))
        print("last response: %s" % (json.dumps(self.last, sort_keys=True) if self.last else "unavailable"))
        print("(this process only; tool rounds/title requests included; missing/failed streams may be billed; no cost estimate)")


def record_usage(obj):
    tracker = ACTIVE_USAGE.get()
    if tracker is not None:
        tracker.record(obj)


def compact_messages(messages, keep):
    """Drop whole old user turns, preserving all tool call/result pairs in retained turns."""
    if type(keep) is not int or keep < 1:
        raise AIError("usage: /compact [positive number of recent turns, default 4]")
    system = []
    turns = []
    for message in messages:
        if message.get("role") == "system":
            system.append(message)
            continue
        if message.get("role") == "user" or not turns:
            turns.append([])
        turns[-1].append(message)
    if len(turns) <= keep:
        return list(messages), 0
    return system + [m for turn in turns[-keep:] for m in turn], len(turns) - keep


def load_profile(name, path):
    """Explicit opt-in config; never fall back to a different provider's key."""
    try:
        with open(path, "rb") as f:
            raw = f.read(1024 * 1024 + 1)
        if len(raw) > 1024 * 1024:
            raise ValueError("profile file exceeds 1 MiB")
        obj = json.loads(raw)
        if not isinstance(obj, dict) or set(obj) != {"version", "profiles"} or obj["version"] != 1:
            raise ValueError("expected version 1 and profiles")
        profiles = obj["profiles"]
        if not isinstance(profiles, dict) or name not in profiles:
            raise ValueError("unknown profile: " + name)
        p = profiles[name]
        required = {"base", "model", "key_env", "capabilities"}
        if not isinstance(p, dict) or set(p) != required:
            raise ValueError("profile requires base, model, key_env, capabilities only")
        if not all(isinstance(p[k], str) and p[k].strip() for k in ("base", "model", "key_env")):
            raise ValueError("base/model/key_env must be nonempty strings")
        base = urllib.parse.urlsplit(p["base"])
        if (base.scheme not in ("http", "https") or not base.hostname or base.username or
                base.password or base.query or base.fragment or base.port == 0):
            raise ValueError("base must be an HTTP(S) URL without credentials/query/fragment")
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", p["key_env"]):
            raise ValueError("invalid key_env")
        caps = p["capabilities"]
        if not isinstance(caps, dict) or set(caps) != {"tools", "vision", "stream", "token_parameter"}:
            raise ValueError("capabilities requires tools, vision, stream, token_parameter")
        if any(type(caps[k]) is not bool for k in ("tools", "vision", "stream")):
            raise ValueError("capability flags must be booleans")
        if caps["token_parameter"] not in ("max_tokens", "max_completion_tokens", None):
            raise ValueError("invalid token_parameter")
        return dict(p, base=p["base"].rstrip("/"), name=name)
    except (OSError, ValueError, TypeError) as e:
        raise AIError("cannot load provider profile: %s" % e) from e


def chat_payload(model, messages, stream, temp, max_tok, tools):
    profile = ACTIVE_PROFILE.get()
    caps = profile["capabilities"] if profile else None
    if caps:
        if model != profile["model"]:
            raise AIError("model differs from profile; select a matching profile")
        if stream and not caps["stream"]:
            raise AIError("profile does not support streaming; use --no-stream")
        if tools is not None and not caps["tools"]:
            raise AIError("profile does not support tools")
        if not caps["vision"] and any(
                isinstance(m.get("content"), list) and any(
                    p.get("type") == "image_url" for p in m["content"] if isinstance(p, dict))
                for m in messages):
            raise AIError("profile does not support vision; image was not sent")
    payload = {"model": model, "messages": messages, "stream": stream}
    if stream and STREAM_USAGE.get():
        payload["stream_options"] = {"include_usage": True}
    if tools is not None:
        payload.update(tools=tools, tool_choice="auto")
    if temp is not None:
        payload["temperature"] = temp
    if max_tok is not None:
        parameter = caps["token_parameter"] if caps else "max_tokens"
        if parameter is None:
            raise AIError("profile does not support a token limit parameter")
        payload[parameter] = max_tok
    return payload


def resolve_system(cli_system, cli_file):
    if cli_system:
        return cli_system, "--system"
    path = cli_file or os.environ.get("DANI_AI_SYSTEM_FILE", "").strip()
    if not path:
        path = default_system_file()
        if not os.path.isfile(path):
            return "", ""
    elif not os.path.isfile(path):
        print("dani-ai: system file not found: %s" % path, file=sys.stderr)
        sys.exit(1)
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
        return text, path
    except OSError as e:
        print("dani-ai: cannot read system file: %s" % e, file=sys.stderr)
        sys.exit(1)


