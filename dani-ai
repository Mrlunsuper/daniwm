#!/usr/bin/env python3
"""dani-ai — minimal BYOK chat CLI (OpenAI-compatible).

Single-shot:  dani-ai "cau hoi" [--system ...] [--model ...]
REPL:         dani-ai chat [--continue [NAME]]  (/save, /reset, ...)
List models:  dani-ai models
List chats:   dani-ai history
Pipe:         cat f | dani-ai "tom tat"
Key order:    --api-key > DANI_AI_API_KEY > OPENAI_API_KEY
              > DEEPSEEK_API_KEY > FREELLMAPI_API_KEY > VILAO_API_KEY
              > ~/.config/daniwm/ai.key (works when WM spawns without
              your shell env; chmod 600; lines: key, [api base], [model])
System order: --system > --system-file > DANI_AI_SYSTEM_FILE
              > ~/.config/daniwm/ai.system
Only stdlib. Streaming default on, --no-stream to disable.
"""
import argparse
import json
import os
import re
import shutil
import sys
import time
import urllib.error
import urllib.request

try:
    import readline as _rl
except ImportError:
    _rl = None

VERSION = "0.1.0"
DEFAULT_BASE = "https://api.openai.com/v1"
DEEPSEEK_BASE = "https://api.deepseek.com/v1"
DEFAULT_MODEL = "gpt-4o-mini"
DEEPSEEK_MODEL = "deepseek-chat"

KEY_ENVS = (
    "DANI_AI_API_KEY",
    "OPENAI_API_KEY",
    "DEEPSEEK_API_KEY",
    "FREELLMAPI_API_KEY",
    "VILAO_API_KEY",
)


def default_system_file():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(xdg, "daniwm", "ai.system")


def history_dir():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(xdg, "daniwm", "ai-history")


def save_session(path, model, messages):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"model": model, "messages": messages}, f,
                      ensure_ascii=False)
        return True
    except OSError as e:
        print("dani-ai: cannot save: %s" % e, file=sys.stderr)
        return False


def load_session(path):
    try:
        with open(path, encoding="utf-8") as f:
            obj = json.load(f)
        return obj.get("model", ""), obj.get("messages", [])
    except (OSError, ValueError) as e:
        print("dani-ai: cannot load %s: %s" % (path, e), file=sys.stderr)
        return None, None


def has_content(messages):
    return any(m.get("role") in ("user", "assistant") for m in messages)


def default_key_file():
    xdg = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(xdg, "daniwm", "ai.key")


def read_key_file():
    """Key file lines: key, [api base], [model]. Blank/# lines skipped."""
    path = os.environ.get("DANI_AI_KEY_FILE", "").strip() or default_key_file()
    if not os.path.isfile(path):
        return "", "", "", ""
    try:
        with open(path, encoding="utf-8") as f:
            lines = [ln.strip() for ln in f if ln.strip() and not ln.startswith("#")]
    except OSError:
        return "", "", "", ""
    key = lines[0] if len(lines) > 0 else ""
    base = lines[1] if len(lines) > 1 else ""
    model = lines[2] if len(lines) > 2 else ""
    return key, base, model, path


def resolve_key(cli_key):
    if cli_key:
        return cli_key, "--api-key"
    for name in KEY_ENVS:
        val = os.environ.get(name, "").strip()
        if val:
            return val, name
    key, _, _, path = read_key_file()
    if key:
        return key, path
    return "", ""


def resolve_base(cli_base, key_source, file_base):
    if cli_base:
        return cli_base.rstrip("/"), "--api-base"
    for name in ("DANI_AI_API_BASE", "OPENAI_API_BASE"):
        val = os.environ.get(name, "").strip()
        if val:
            return val.rstrip("/"), name
    if file_base:
        return file_base.rstrip("/"), "ai.key"
    if key_source == "DEEPSEEK_API_KEY":
        return DEEPSEEK_BASE, "auto(deepseek)"
    return DEFAULT_BASE, "default"


def resolve_model(cli_model, base, file_model):
    if cli_model:
        return cli_model, "--model"
    val = os.environ.get("DANI_AI_MODEL", "").strip()
    if val:
        return val, "DANI_AI_MODEL"
    if file_model:
        return file_model, "ai.key"
    if base == DEEPSEEK_BASE:
        return DEEPSEEK_MODEL, "auto(deepseek)"
    return DEFAULT_MODEL, "default"


def resolve_system(cli_system, cli_file):
    if cli_system:
        return cli_system, "--system"
    path = cli_file or os.environ.get("DANI_AI_SYSTEM_FILE", "").strip()
    if not path:
        path = default_system_file()
        if not os.path.isfile(path):
            return "", ""
    elif not os.path.isfile(path):
        print("dani-ai: system file not found: %s" % path, file=sys.stderr)
        sys.exit(1)
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read().strip()
        return text, path
    except OSError as e:
        print("dani-ai: cannot read system file: %s" % e, file=sys.stderr)
        sys.exit(1)


def build_parser():
    p = argparse.ArgumentParser(
        prog="dani-ai",
        description="BYOK chat CLI (OpenAI-compatible /chat/completions).",
    )
    p.add_argument("prompt", nargs="*", help="single-shot prompt, or 'chat' / 'models'")
    p.add_argument("--chat", action="store_true", help="force REPL mode")
    p.add_argument("--api-key", default="", help="API key (else env, see --show-config)")
    p.add_argument("--api-base", default="", help="base URL, e.g. https://api.deepseek.com/v1")
    p.add_argument("--model", default="", help="model name")
    p.add_argument("--system", default="", help="system prompt text")
    p.add_argument("--system-file", default="", help="path to system prompt file")
    p.add_argument("--temperature", type=float, default=None)
    p.add_argument("--max-tokens", type=int, default=None)
    p.add_argument("--timeout", type=float, default=60)
    p.add_argument("--stream", dest="stream", action="store_true", default=True)
    p.add_argument("--no-stream", dest="stream", action="store_false")
    p.add_argument("--no-color", dest="color", action="store_false", default=True,
                   help="disable markdown colors (auto-off when piped)")
    p.add_argument("--continue", dest="cont", nargs="?", const="last",
                   metavar="NAME", help="resume saved chat (default: last)")
    p.add_argument("--show-config", action="store_true", help="print resolved config, exit")
    p.add_argument("--version", action="store_true")
    return p


def post_json(url, payload, api_key, timeout):
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer " + api_key,
        },
        method="POST",
    )
    try:
        return urllib.request.urlopen(req, timeout=timeout)
    except urllib.error.HTTPError as e:
        try:
            body = e.read().decode("utf-8", "replace")[:500]
        except Exception:
            body = ""
        print("dani-ai: HTTP %s %s" % (e.code, body), file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print("dani-ai: connection error: %s" % e, file=sys.stderr)
        sys.exit(1)


def request_once(base, api_key, model, messages, timeout, temp, max_tok):
    payload = {"model": model, "messages": messages, "stream": False}
    if temp is not None:
        payload["temperature"] = temp
    if max_tok is not None:
        payload["max_tokens"] = max_tok
    with post_json(base + "/chat/completions", payload, api_key, timeout) as r:
        try:
            obj = json.loads(r.read().decode("utf-8"))
        except (ValueError, UnicodeDecodeError) as e:
            print("dani-ai: bad JSON response: %s" % e, file=sys.stderr)
            sys.exit(1)
    try:
        return obj["choices"][0]["message"]["content"] or ""
    except (KeyError, IndexError, TypeError):
        print("dani-ai: unexpected response: %s" % json.dumps(obj)[:500], file=sys.stderr)
        sys.exit(1)


def list_models(base, api_key, timeout):
    """GET {base}/models, return sorted ids or None on error."""
    req = urllib.request.Request(
        base + "/models",
        headers={"Authorization": "Bearer " + api_key},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            obj = json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        print("dani-ai: models HTTP %s" % e.code, file=sys.stderr)
        return None
    except urllib.error.URLError as e:
        print("dani-ai: models connection error: %s" % e, file=sys.stderr)
        return None
    except ValueError:
        print("dani-ai: models bad JSON response", file=sys.stderr)
        return None
    try:
        return sorted(m["id"] for m in obj["data"])
    except (KeyError, TypeError):
        print("dani-ai: models unexpected response", file=sys.stderr)
        return None


def request_stream(base, api_key, model, messages, timeout, temp, max_tok, out,
                   live=None):
    payload = {"model": model, "messages": messages, "stream": True}
    if temp is not None:
        payload["temperature"] = temp
    if max_tok is not None:
        payload["max_tokens"] = max_tok
    full = []
    pending = ""
    with post_json(base + "/chat/completions", payload, api_key, timeout) as r:
        while True:
            raw = r.readline()
            if not raw:
                break
            text = raw.decode("utf-8", "replace").strip()
            if not text.startswith("data:"):
                continue
            data = text[5:].strip()
            if data == "[DONE]":
                break
            try:
                obj = json.loads(data)
                delta = obj["choices"][0].get("delta", {}).get("content", "")
            except (ValueError, KeyError, IndexError, TypeError):
                continue
            if delta:
                full.append(delta)
                if live is None:
                    out.write(delta)
                    out.flush()
                else:
                    pending += delta
                    while "\n" in pending:
                        ln, pending = pending.split("\n", 1)
                        out.write(live.render(ln) + "\n")
                        out.flush()
    if live is not None and pending:
        out.write(live.render(pending))
        out.flush()
    out.write("\n")
    out.flush()
    return "".join(full)


def complete(base, api_key, model, messages, timeout, temp, max_tok, stream, out,
               render=False):
    if render:
        title = "AI · %s" % model
        if stream:
            fw = _FrameWriter(out, title)
            raw = request_stream(base, api_key, model, messages, timeout, temp,
                                 max_tok, fw, _MdLive())
            fw.end()
            return raw
        raw = request_once(base, api_key, model, messages, timeout, temp, max_tok)
        out.write(frame_answer(render_markdown(raw), title) + "\n")
        out.flush()
        return raw
    if stream:
        return request_stream(base, api_key, model, messages, timeout, temp, max_tok, out)
    text = request_once(base, api_key, model, messages, timeout, temp, max_tok)
    out.write(text)
    if not text.endswith("\n"):
        out.write("\n")
    out.flush()
    return text


# ---- minimal markdown -> ANSI (TTY only, stdlib) ----

_A_B = "\x1b[1m"
_A_DIM = "\x1b[2m"
_A_ITAL = "\x1b[3m"
_A_CYAN = "\x1b[36m"
_A_GREEN = "\x1b[32m"
_A_YELLOW = "\x1b[33m"
_A_MAG = "\x1b[35m"
_A_RST = "\x1b[0m"


def render_inline(s):
    codes = []

    def stash(m):
        codes.append(m.group(1))
        return "\x00%d\x00" % (len(codes) - 1)

    s = re.sub(r"`([^`\n]+)`", stash, s)
    s = re.sub(r"\*\*([^*]+)\*\*", _A_B + r"\1" + _A_RST, s)
    s = re.sub(r"(?<!\w)\*([^*]+)\*(?!\w)", _A_ITAL + r"\1" + _A_RST, s)
    s = re.sub(r"(?<!\w)_([^_]+)_(?!\w)", _A_ITAL + r"\1" + _A_RST, s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)",
               _A_B + r"\1" + _A_RST + _A_DIM + r" (\2)" + _A_RST, s)
    for i, c in enumerate(codes):
        s = s.replace("\x00%d\x00" % i, _A_GREEN + c + _A_RST)
    return s


class _MdLive:
    """Stateful line renderer: keeps code-fence state across streamed lines."""

    def __init__(self):
        self.fence = False

    def render(self, line):
        s = line
        if s.strip().startswith("```"):
            self.fence = not self.fence
            return _A_DIM + ("─" * 24) + _A_RST
        if self.fence:
            return _A_CYAN + s + _A_RST if s else s
        m = re.match(r"^(#{1,6})\s+(.*)$", s)
        if m:
            color = _A_YELLOW if len(m.group(1)) <= 2 else _A_MAG
            return _A_B + color + render_inline(m.group(2)) + _A_RST
        m = re.match(r"^(\s*)[-*+]\s+(.*)$", s)
        if m:
            return (m.group(1) + _A_YELLOW + "•" + _A_RST + " " +
                    render_inline(m.group(2)))
        m = re.match(r"^(\s*)(\d+[.)])\s+(.*)$", s)
        if m:
            return (m.group(1) + _A_YELLOW + m.group(2) + _A_RST + " " +
                    render_inline(m.group(3)))
        m = re.match(r"^\s*>\s?(.*)$", s)
        if m:
            return _A_DIM + "│ " + render_inline(m.group(1)) + _A_RST
        if re.match(r"^\s*(-{3,}|\*{3,}|_{3,})\s*$", s):
            return _A_DIM + ("─" * 24) + _A_RST
        return render_inline(s)


def render_markdown(text):
    live = _MdLive()
    return "\n".join(live.render(ln) for ln in text.split("\n"))


def color_enabled(cli_color):
    if not cli_color:
        return False
    if os.environ.get("NO_COLOR"):
        return False
    return sys.stdout.isatty()


# ---- chat frames (TTY only): boxed input + boxed answer ----

def term_width():
    try:
        return max(40, min(shutil.get_terminal_size().columns, 88))
    except OSError:
        return 70


def _frame_head(title, width):
    return (_A_DIM + ("┌─ %s " % title).ljust(width, "─") + _A_RST)


def _frame_foot(width):
    return _A_DIM + ("└" + "─" * (width - 1)) + _A_RST


def _frame_line(ln):
    if ln:
        return _A_DIM + "│" + _A_RST + " " + ln
    return _A_DIM + "│" + _A_RST


def frame_answer(text, title, width=None):
    w = width or term_width()
    lines = [_frame_head(title, w)]
    lines += [_frame_line(ln) for ln in text.split("\n")]
    lines.append(_frame_foot(w))
    return "\n".join(lines)


class _FrameWriter:
    """File-like wrapper: frames streamed lines live with │ prefix."""

    def __init__(self, out, title, width=None):
        self.out = out
        self.buf = ""
        w = width or term_width()
        out.write(_frame_head(title, w) + "\n")
        out.flush()
        self.foot = _frame_foot(w)

    def write(self, s):
        self.buf += s
        while "\n" in self.buf:
            ln, self.buf = self.buf.split("\n", 1)
            self.out.write(_frame_line(ln) + "\n")
            self.out.flush()

    def flush(self):
        self.out.flush()

    def end(self):
        if self.buf:
            self.out.write(_frame_line(self.buf) + "\n")
            self.buf = ""
        self.out.write(self.foot + "\n")
        self.out.flush()


def input_boxed():
    if not sys.stdout.isatty():
        return input("> ")
    w = term_width()
    print(_A_DIM + ("┌─ Bạn ".ljust(w, "─")) + _A_RST)
    return input(_A_B + _A_GREEN + "└─❯ " + _A_RST)


# ---- REPL slash-command completion + hints (readline, stdlib) ----

COMMANDS = [
    "/base", "/clear", "/color", "/exit", "/help", "/model",
    "/new", "/q", "/quit", "/reset", "/save", "/stream", "/system",
]


def suggest_command(text):
    if not text.startswith("/"):
        return None
    if text == "/":
        return "commands: " + " ".join(COMMANDS)
    matches = [c for c in COMMANDS if c.startswith(text)]
    if text in COMMANDS or not matches:
        return None
    if len(matches) == 1:
        return "did you mean %s?" % matches[0]
    return "did you mean: " + " ".join(matches)


def complete_token(hist_dir, buf, text, state):
    """Pure completer core (testable without a live readline session)."""
    if buf.startswith("/save "):
        try:
            names = [f[:-5] for f in os.listdir(hist_dir)
                     if f.endswith(".json")]
        except OSError:
            names = []
        opts = sorted(n for n in names if n.startswith(text))
    elif text.startswith("/"):
        opts = sorted(c for c in COMMANDS if c.startswith(text))
    else:
        return None
    if state < len(opts):
        return opts[state]
    return None


def setup_readline(hist_dir):
    """Tab completion + arrow-up history. Returns history file or ''."""
    if _rl is None:
        return ""
    try:
        _rl.set_completer_delims(" \t\n")
        _rl.set_completer(
            lambda text, state: complete_token(
                hist_dir, _rl.get_line_buffer(), text, state))
        _rl.parse_and_bind("tab: complete")
        _rl.set_history_length(200)
        hf = os.path.join(hist_dir, ".repl_history")
        try:
            _rl.read_history_file(hf)
        except OSError:
            pass
        return hf
    except Exception:
        return ""


def read_piped_stdin():
    if sys.stdin.isatty():
        return ""
    try:
        data = sys.stdin.read()
    except OSError:
        return ""
    return data.strip()


def repl(base, api_key, model, system, timeout, temp, max_tok, stream, color,
         hist_dir, initial=None):
    if initial is not None:
        model, messages = initial
        n = len([m for m in messages if m["role"] != "system"])
        print("(resumed %d messages, model=%s)" % (n, model))
    else:
        messages = []
        if system:
            messages.append({"role": "system", "content": system})
    print("dani-ai chat (%s). /help for commands, Tab completes, Ctrl-D to quit."
          % model)
    histfile = setup_readline(hist_dir)
    while True:
        try:
            line = input_boxed()
        except EOFError:
            print("")
            break
        except KeyboardInterrupt:
            print("")
            break
        s = line.strip()
        if not s:
            continue
        if _rl is not None:
            try:
                _rl.add_history(line)
            except Exception:
                pass
        if s in ("/quit", "/exit", "/q"):
            break
        if s in ("/reset", "/clear", "/new"):
            messages = [{"role": "system", "content": system}] if system else []
            print("(history cleared)")
            continue
        if s in ("/help", "/h", "/?"):
            print("/reset xoa lich su  /system <t> doi system  /model (chon so)  /base <u>")
            print("/save [ten]  /stream on|off  /color on|off  /quit")
            print("Commands: /reset /system /model /base /save /stream /color /quit")
            continue
        if s == "/save" or s.startswith("/save "):
            name = s[len("/save"):].strip() or time.strftime("%Y%m%d-%H%M%S")
            safe = re.sub(r"[^A-Za-z0-9_-]+", "-", name).strip("-") or "chat"
            if save_session(os.path.join(hist_dir, safe + ".json"), model,
                            messages):
                print("(saved %s)" % safe)
            continue
        if s.startswith("/system"):
            messages = [m for m in messages if m["role"] != "system"]
            new_sys = s[len("/system"):].strip()
            if new_sys:
                system = new_sys
                messages.insert(0, {"role": "system", "content": system})
                print("(system updated)")
            else:
                system = ""
                print("(system cleared)")
            continue
        if s == "/model":
            ids = list_models(base, api_key, timeout)
            if not ids:
                continue
            for i, mid in enumerate(ids, 1):
                print("%d. %s" % (i, mid))
            try:
                pick = input("model # or name (Enter = keep %s): " % model).strip()
            except (EOFError, KeyboardInterrupt):
                print("")
                continue
            if not pick:
                print("model = %s" % model)
            elif pick.isdigit() and 1 <= int(pick) <= len(ids):
                model = ids[int(pick) - 1]
                print("(model = %s)" % model)
            else:
                model = pick
                print("(model = %s)" % model)
            continue
        if s.startswith("/model "):
            model = s[len("/model"):].strip()
            print("(model = %s)" % model)
            continue
        if s.startswith("/base"):
            url = s[len("/base"):].strip()
            if url:
                base = url.rstrip("/")
                print("(base = %s)" % base)
            else:
                print("base = %s" % base)
            continue
        if s.startswith("/stream"):
            arg = s[len("/stream"):].strip().lower()
            if arg in ("on", "1", "true"):
                stream = True
            elif arg in ("off", "0", "false"):
                stream = False
            print("(stream %s)" % ("on" if stream else "off"))
            continue
        if s.startswith("/color"):
            arg = s[len("/color"):].strip().lower()
            if arg in ("on", "1", "true"):
                color = True
            elif arg in ("off", "0", "false"):
                color = False
            print("(color %s)" % ("on" if color else "off"))
            continue
        if s.startswith("/"):
            hint = suggest_command(s)
            print(hint or "unknown command. /help")
            continue
        messages.append({"role": "user", "content": s})
        try:
            reply = complete(base, api_key, model, messages, timeout, temp, max_tok,
                             stream, sys.stdout, color)
        except BrokenPipeError:
            break
        messages.append({"role": "assistant", "content": reply})
    if has_content(messages):
        try:
            if save_session(os.path.join(hist_dir, "last.json"), model, messages):
                print("(auto-saved, --continue to resume)")
        except (BrokenPipeError, OSError):
            pass
    if histfile and _rl is not None:
        try:
            os.makedirs(hist_dir, exist_ok=True)
            _rl.write_history_file(histfile)
        except Exception:
            pass


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.version:
        print("dani-ai " + VERSION)
        return 0
    api_key, key_source = resolve_key(args.api_key)
    file_base, file_model = "", ""
    if key_source and key_source != "--api-key" and key_source not in KEY_ENVS:
        _, file_base, file_model, _ = read_key_file()
    base, base_source = resolve_base(args.api_base, key_source, file_base)
    system, system_source = resolve_system(args.system, args.system_file)
    hist = history_dir()
    saved_model, saved_msgs = "", None
    if args.cont is not None:
        name = args.cont if args.cont.endswith(".json") else args.cont + ".json"
        saved_model, saved_msgs = load_session(os.path.join(hist, name))
        if saved_msgs is None:
            return 1
    if args.model:
        model, model_source = args.model, "--model"
    elif saved_model:
        model, model_source = saved_model, "history"
    else:
        model, model_source = resolve_model("", base, file_model)
    if args.show_config:
        if not api_key:
            masked = "(empty)"
        elif len(api_key) > 4:
            masked = "•••" + api_key[-4:]
        else:
            masked = "•••(set)"
        print("api_base = %s  (%s)" % (base, base_source))
        print("model = %s  (%s)" % (model, model_source))
        print("key = %s  (%s)" % (masked, key_source or "missing"))
        print("system = %s" % (system_source or "(none)"))
        if system:
            print("--- system preview ---")
            print(system[:300])
        return 0
    if not api_key:
        print("dani-ai: missing API key. Set DANI_AI_API_KEY (or OPENAI_API_KEY /",
              file=sys.stderr)
        print("  DEEPSEEK_API_KEY), pass --api-key, or save the key as the",
              file=sys.stderr)
        print("  first line of ~/.config/daniwm/ai.key (chmod 600).", file=sys.stderr)
        return 2
    words = list(args.prompt)
    want_chat = args.chat or (len(words) == 1 and words[0] == "chat")
    if want_chat and not args.chat:
        words = []
    render = color_enabled(args.color)
    if len(words) == 1 and words[0] == "models":
        ids = list_models(base, api_key, args.timeout)
        if ids is None:
            return 1
        for mid in ids:
            print(mid)
        return 0
    if len(words) == 1 and words[0] == "history":
        try:
            files = [f for f in os.listdir(hist) if f.endswith(".json")]
        except OSError:
            files = []
        files.sort(key=lambda f: os.path.getmtime(os.path.join(hist, f)),
                   reverse=True)
        if not files:
            print("(no saved chats)")
            return 0
        for f in files:
            sm, msgs = load_session(os.path.join(hist, f))
            if msgs is None:
                continue
            first = next((m.get("content", "") for m in msgs
                          if m.get("role") == "user"), "")
            first = first.replace("\n", " ")[:60]
            n = len([m for m in msgs if m.get("role") != "system"])
            print("%s  %s  %d msgs  %s" % (f[:-5], sm or "-", n, first))
        return 0
    initial = None
    if saved_msgs is not None:
        initial = (model, saved_msgs)
    if want_chat:
        repl(base, api_key, model, system, args.timeout,
             args.temperature, args.max_tokens, args.stream, render, hist,
             initial)
        return 0
    piped = read_piped_stdin()
    if not words and not piped:
        repl(base, api_key, model, system, args.timeout,
             args.temperature, args.max_tokens, args.stream, render, hist,
             initial)
        return 0
    prompt = " ".join(words).strip()
    if piped:
        prompt = (prompt + "\n\n" + piped).strip() if prompt else piped
    if not prompt:
        print("dani-ai: empty prompt.", file=sys.stderr)
        return 1
    messages = []
    if system:
        messages.append({"role": "system", "content": system})
    messages.append({"role": "user", "content": prompt})
    complete(base, api_key, model, messages, args.timeout,
             args.temperature, args.max_tokens, args.stream, sys.stdout, render)
    return 0


if __name__ == "__main__":
    sys.exit(main())
