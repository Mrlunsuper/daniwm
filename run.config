# dani-run config — ~/.config/daniwm/run.config
# (symlink to repo: ln -s ~/daniwm/run.config ~/.config/daniwm/run.config)
# key = value, # comment. app=/power= can repeat over lines;
# first line clears defaults (like daniwm bind/rule).

font = SpaceMono Nerd Font:size=13
cols = 5
lines = 8
drun_lines = 12   # rows in drun list mode (3..16, auto-shrinks on short screens)
width = 800      # drun window width (320..1200)
cell_w = 36     # each fav/power grid cell width (80..240)
cell_h = 112     # each fav/power grid cell height (64..200)
input_h = 44     # input band height (24..96)
#
# Spacing (all optional). `padding`/`cell_gap` are shorthands for all sides /
# both axes; the more specific keys below override them when set afterwards.
#
padding = 0        # inner window margin, all sides (0..64)
#padding_top = 32     # override top    (0..64)
#padding_right = 0   # override right  (0..64)
#padding_bottom = 32  # override bottom (0..64)
#padding_left = 0    # override left   (0..64)
#
# Per-mode overrides: drun_padding* for the drun list, grid_padding* for
# fav/power grids. If unset, the plain padding* values above apply. Uncomment
# to give drun and the grids different spacing:
#drun_padding = 0            # drun: all sides shorthand
drun_padding_top = 12       # drun: per-side override
drun_padding_bottom = 12
#grid_padding = 16           # fav/power: all sides shorthand
#grid_padding_top = 20
#grid_padding_bottom = 12
row_gap = 10        # vertical gap between drun rows (0..32)
cell_gap = 6       # gap between fav/power grid cells, both axes (0..64)
cell_gap_x = 8     # override horizontal gap (0..64)
cell_gap_y = 6     # override vertical gap (0..64)
margin = 12        # left/right margin of the selection pill (0..64)
drun_icons = 0   # show the app's real icon (PNG from the icon theme, rofi-style) in the drun list (0/1)
# opacity = 92     # OPTIONAL whole-window translucency %, 1..100 (100 = opaque). Default 100.
                 # Applied via _NET_WM_WINDOW_OPACITY; dani-comp composites it (needs dani-comp).
                 # Low values wash out icons/text behind the launcher (tray, terminal).
                 # For a subtle glassy look keep it >= 90.
icon_theme =     # optional: icon theme name (default: GTK gtk-icon-theme-name, e.g. Papirus-Dark)

# app = icon ; name ; command (split only on first 2 ';', command keeps spaces)
# icon = 1 Nerd Font glyph, empty -> use first letter of the name.
app = ;Helium;sh -c "wmctrl -x -a helium.Helium || helium"
app = ;Local;sh -c "wmctrl -x -a Local || /opt/Local/local"
app = ;Slack;sh -c "wmctrl -x -a slack || slack"
app = ;MT5;sh -c "wmctrl -x -a terminal64 || mt5"
app = ;WCVF;sh -c "wmctrl -x -a WCVF || alacritty --class WCVF,Alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors'"
app = ;WCVP;sh -c "wmctrl -x -a WCVP || alacritty --class WCVP,Alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-pro'"
app = ;WCVE;sh -c "wmctrl -x -a WCVE || alacritty --class WCVE,Alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-engage'"
app = ;WCVSU;sh -c "wmctrl -x -a WCVSU || alacritty --class WCVSU,Alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-signup'"
app = ;WCV Stripe;sh -c "wmctrl -x -a WCVStripe || alacritty --class WCVStripe,Alacritty -e bash -ic 'zdev ~/wcvdev/wc-vendors-gateway-stripe-connect/'"
app = ;SaveTo;sh -c "wmctrl -x -a SaveTo || alacritty --class SaveTo,Alacritty -e bash -ic 'zdev ~/wcvdev/saveto-wishlist-lite-for-woocommerce/'"
app = ;WWP;sh -c "wmctrl -x -a WWP || alacritty --class WWP,Alacritty -e bash -ic 'zdev ~/wcvdev/woocommerce-wholesale-prices/'"
app = ;WWPP;sh -c "wmctrl -x -a WWPP || alacritty --class WWPP,Alacritty -e bash -ic 'zdev ~/wcvdev/woocommerce-wholesale-prices-premium/'"
app = ;WWQ;sh -c "wmctrl -x -a WWQ || alacritty --class WWQ,Alacritty -e bash -ic 'zdev ~/wcvdev/woocommerce-wholesale-quotes/'"
app = ;WPAY;sh -c "wmctrl -x -a WPAY || alacritty --class WPAY,Alacritty -e bash -ic 'zdev ~/wcvdev/woocommerce-wholesale-payments/'"
app = ;WWOF;sh -c "wmctrl -x -a WWOF || alacritty --class WWOF,Alacritty -e bash -ic 'zdev ~/wcvdev/woocommerce-wholesale-order-form/'"
power = ;Lock;loginctl lock-session
power = ;Logout;pkill daniwm
power = ;Reboot;systemctl reboot
power = ;Off;systemctl poweroff
power = ;Suspend;systemctl suspend
