# daniwm config — ~/.config/daniwm/config
# key = value, # comment. Reload nóng bằng Super+Shift+r (không cần restart).
# Dòng bind đầu tiên thay toàn bộ bảng phím mặc định; rule đầu tiên thay rules mặc định.

# ---------- terminal & menu ----------
# Đổi terminal: sửa 1 dòng term = ghostty | kitty | foot | xterm
term = alacritty
menu = dani-run                          # launcher cua nha (drun/fav/power); cu: rofi -show drun
rename_cmd = rofi -dmenu -i -p rename  # prompt của ws_rename (stdout = tên mới;
                                     # $DANIWM_WS_CUR/_NUM dùng được trong cmd;
                                     # Esc = giữ tên cũ, Enter trống = về số)
scratch = alacritty --class scratchpad   # giữ chữ "scratchpad" để toggle tìm được

# ---------- extra binds (giữ nguyên list `bind =` bên dưới) ----------
# `bind =` thay TOÀN BỘ phím mặc định; `bind+` = thêm vào, giữ nguyên.
bind+ = mod+a:exec dani-run --fav
bind+ = mod+Shift+p:exec dani-run --power
# AI chat (dani-ai, BYOK): mo terminal tro chuyen. Key dani-ai doc tu
# ~/.config/daniwm/ai.system, API key qua DANI_AI_API_KEY.
bind+ = mod+Shift+a:exec alacritty -e dani-ai chat
# mod+d (menu) đã có ở list bên dưới, không cần thêm.

# ---------- general ----------
mod = super                          # super | alt | ctrl
workspaces = 7                       # 1..10 — đồng bộ với bspwm (I-VII)
# tên workspace (hiện trên bar + _NET_DESKTOP_NAMES cho pager).
# Dạng khác: "My Web" (giữ space) | 1:Web 2:Code (theo index) | ws_name_1 = Web.
# Thiếu tên = hiện số. Reload nóng Super+Shift+r.
ws_names = chat dev web term trade mics wtf # tên ws1..6, ws7 hiện số
ws_icon_1 =   # icon từng ws (Nerd Font, hiện trước tên trên bar)
ws_icon_2 = 
ws_icon_3 = 
ws_icon_4 = 
ws_icon_5 = 
ws_icon_6 = 
ws_icon_7 = 
mfact = 0.50                        # master chiếm 0.1..0.9 chiều ngang
nmaster = 1                          # số cửa sổ master
border = 2
border_focus = 8CCF7E                # Everblush green (focused)
border_normal = 232A2D               # gần như nền (unfocused)
gaps_on = 1
gap_outer = 4
gap_inner = 8
# ---------- dani-comp (compositor của nhà trồng, thay picom) ----------
# daniwm KHÔNG quản lý compositor nữa — khởi động ở autostart.sh:
#   run_once dani-comp "$HOME/daniwm/dani-comp" --shadow --no-fade --dim 1
# Muốn chỉnh shadow/fade/dim thì sửa dòng đó trong autostart.sh.
# Toggle nóng để restart/test: bind = mod+c:compositor  (tùy chọn)
bar_on = 1
tray = 1                          # system tray XEmbed ở mép phải bar (1/0)
tray_gap = 8                     # khoảng cách giữa các icon tray (px, 0..32)
bar_h = 48
bar_ws_pad = 12                   # padding chữ 2 bên trong ô workspace có tên (px, 0..32)
ws_w = 36
bar_pad_l = 8
bar_pad_r = 16
# màu bar: hex 6 số, có thể có #. Áp ngay khi reload.
# Everblush:
bar_bg = 141B1E
bar_fg = DADADA
bar_acc = 8CCF7E
bar_dim = A8AFB2
# style active ws: pill (default, gọn) | underline | block (khối fill kiểu cũ)
bar_ws_style       = pill
bar_ws_active      = 232A2D   # pill / underline / block của ws đang xem
bar_ws_active_text = DADADA   # chữ ws đang xem (sáng, nổi trên pill tối)
bar_ws_occ         = DADADA   # chữ workspace có cửa sổ
bar_ws_empty       = A8AFB2   # chữ workspace trống (muted)
bar_urgent         = E57474   # ws urgent + pin yếu + MUTE (đỏ trầm)
bar_sep            = 2C3333   # separator + bottom border (mảnh, tối)
bar_gap            = 1        # spaces quanh separator giữa các module phải (0..8)
bar_sep_str        = |       # separator phải (vd: · | / • : — để trống = chỉ cách spaces)
bar_modules        = cpu mem vol clock  # thứ tự + ẩn/hiện (xóa tên là ẩn, default đủ: "cpu mem bat vol clock"; máy bàn không pin thì `bat` tự ẩn)
clock_fmt          = %d/%m | %H:%M  # strftime (vd: "%H:%M" gọn, "%a %d/%m %H:%M" đầy đủ)
bar_show_title     = 0       # tiêu đề cửa sổ trái (1/0)
bar_show_tasks     = 1        # nút task Awesome: click-trái focus, click-giữa đóng (1/0)
bar_task_w         = 360     # rộng mỗi nút task (px, 0 = auto chia đều; vd 160)
bar_task_pad       = 12        # padding chữ trong nút task (px, 0..32)
bar_ws_task_gap    = 32        # vùng chết giữa ws và tasklist + vạch chia (px, 0..64; click vào đây = no-op)
# style task list: đồng bộ với ws (pill + iris) | đổi pill->underline/block/none nếu thích
bar_task_style        = pill
bar_task_active       = 232A2D   # nền task đang focus (= bar_ws_active)
bar_task_active_text  = DADADA   # chữ task đang focus (sáng trên nền xám đặc)
bar_task_text         = DADADA   # chữ task thường (= bar_ws_occ; urgent vẫn dùng bar_urgent)
bar_show_layout    = 0        # icon tile/monocle + số cửa sổ (1/0)
# icon cụm phải: mặc định là icon Nerd Font (đẹp nhất với font Nerd bên dưới),
# tự rớt về C/M/B/V nếu máy thiếu font. Muốn chữ thường thì mở 3 dòng này:
# ico_cpu = CPU
# ico_vol = VOL
# ico_mem = MEM

bar_mode           = DADADA   # số cửa sổ (icon tile/monocle dùng bar_acc)
bar_title          = A8AFB2   # tiêu đề cửa sổ trái, chìm để nhường sysmon
bar_sys            = DADADA   # giá trị sysmon sáng dễ đọc (icon dùng bar_acc)
# font bar: fontconfig pattern. bar_h=36 hợp với size=11.
font = JetBrainsMono Nerd Font:size=9
# Không có Nerd Font vẫn đẹp (tự rớt về chữ C/M/B/V).

# ---------- rules ----------
# class:title:float:ws[:layout]   (* = bất kỳ; float|tile; ws 1-based, ≤ workspaces; layout = tile|monocle)
rule = scratchpad:*:float:*
rule = Gimp:*:float:*
rule = mpv:*:float:*
rule = org.mozilla.firefox:*:tile:3
rule = slack:*:tile:1               # tự mở vào ws2 (bỏ nếu không dùng)
rule = brave-browser:*:tile:3
rule = thunar:*:float:*
rule = helium:*:tile:3
rule = helium:Sign in:float:*
rule = WCVF:*:tile:2
rule = WCVP:*:tile:2
rule = WCVE:*:tile:2
rule = WCVSU:*:tile:2
rule = WCVStripe:*:tile:2
rule = SaveTo:*:tile:2
rule = WWP:*:tile:2
rule = WWPP:*:tile:2
rule = WWQ:*:tile:2
rule = WPAY:*:tile:2
rule = WWOF:*:tile:2
rule = WSED:*:tile:2
rule = WSLC:*:tile:2
rule = BB:*:tile:2
rule = BBP:*:tile:2
rule = CHP:*:tile:2
rule = RU:*:tile:2
rule = SaveToPro:*:tile:2
rule = SAI:*:tile:2
rule = WCVM:*:tile:2
rule = WCVPAY:*:tile:2
rule = WCSA:*:tile:2
rule = WCVT:*:tile:2
rule = WCVBOOK:*:tile:2
rule = WCVSUB:*:tile:2
rule = WST:*:tile:2
rule = WAD:*:tile:2

bind+ = mod+c:exec dani-run --calc
# ---------- bảng phím ----------
# focus & cửa sổ
bind = mod+j:focus_next
bind = mod+k:focus_prev
bind = mod+ctrl+h:move_left
bind = mod+ctrl+j:move_down
bind = mod+ctrl+k:move_up
bind = mod+ctrl+l:move_right
bind = mod+z:zoom
bind = mod+Tab:ws_toggle
bind = mod+shift+q:kill
bind = mod+shift+space:float          # tiled <-> floating
bind = mod+f:fullscreen
bind = mod+space:toggle               # tile <-> monocle
bind = mod+t:tile
bind = mod+m:monocle

# spawn
bind = mod+Return:spawn_term
bind = mod+d:spawn_menu
bind = mod+s:scratch                  # hiện/ẩn scratchpad
bind = mod+Shift+n:ws_rename          # đổi tên workspace đang xem (rofi/dmenu)
bind = mod+Print:exec flameshot gui
bind = mod+e:exec thunar

# master / layout / gaps / bar
bind = mod+h:mfact_dec
bind = mod+l:mfact_inc
bind = mod+u:nmaster_dec
bind = mod+i:nmaster_inc
bind = mod+g:gap
bind = mod+minus:gap_dec
bind = mod+equal:gap_inc
bind = mod+shift+b:bar
bind = mod+b:exec sh -c "wmctrl -x -a helium.Helium || helium"

# workspace 1..7
bind = mod+1:ws1
bind = mod+2:ws2
bind = mod+3:ws3
bind = mod+4:ws4
bind = mod+5:ws5
bind = mod+6:ws6
bind = mod+7:ws7
bind = mod+Shift+1:mv1
bind = mod+Shift+2:mv2
bind = mod+Shift+3:mv3
bind = mod+Shift+4:mv4
bind = mod+Shift+5:mv5
bind = mod+Shift+6:mv6
bind = mod+Shift+7:mv7

# hệ thống
bind = mod+Shift+r:reload_config
bind = mod+ctrl+r:restart               # thay binary tại chỗ, giữ nguyên cửa sổ
bind = mod+ctrl+e:quit               # thoát WM (kết thúc session X)
rule = flameshot:*:float:*
rule = telegram:*:float:*
rule = local:*:float:7
